<UserControl x:Class="Cargo.Presentation.ContainersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Cargo.Presentation"
             xmlns:controls="using:Cargo.Controls"
             xmlns:utu="using:Uno.Toolkit.UI"
             xmlns:shapes="using:Microsoft.UI.Xaml.Shapes">

  <Grid Style="{StaticResource SectionFrame}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="4">
        <TextBlock Text="Containers" Style="{StaticResource SectionHeadText}" />
        <TextBlock Text="Find a box, follow its journey, release or inspect a hold" Style="{StaticResource CaptionText}" />
      </StackPanel>
      <ItemsControl Grid.Column="1" ItemsSource="{x:Bind Filters, Mode=OneWay}" VerticalAlignment="Bottom">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:FilterChip">
            <Button Style="{StaticResource BareButton}" Command="{x:Bind Apply}" CommandParameter="{x:Bind Label}">
              <Border Background="{x:Bind Background}" BorderBrush="{x:Bind Border}" BorderThickness="1"
                      CornerRadius="99" Padding="13,7">
                <TextBlock Text="{x:Bind Label}" FontFamily="{StaticResource BodyMediumFont}" FontSize="12"
                           Foreground="{x:Bind Foreground}" />
              </Border>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>

    <Grid Grid.Row="1" ColumnSpacing="18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="520" />
        <ColumnDefinition Width="360" />
      </Grid.ColumnDefinitions>

      <ItemsControl ItemsSource="{x:Bind Cards, Mode=OneWay}" VerticalAlignment="Top">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <controls:TileGridPanel MinTileWidth="240" Gap="14" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:ContainerCard">
            <Button Style="{StaticResource RowButton}" Command="{x:Bind Select}" CommandParameter="{x:Bind Id}">
              <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{x:Bind Border}" BorderThickness="1"
                      CornerRadius="14" Padding="16,14">
                <StackPanel Spacing="6">
                  <Grid>
                    <Border CornerRadius="10" Padding="6,8,6,4">
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                          <GradientStop Offset="0" Color="{StaticResource SurfaceColor}" />
                          <GradientStop Offset="1" Color="{StaticResource SeaLightColor}" />
                        </LinearGradientBrush>
                      </Border.Background>
                      <Image Source="{x:Bind Render}" Height="72" Stretch="Uniform" />
                    </Border>
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="7,2"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                      <TextBlock Text="{x:Bind IdPretty}" FontFamily="{StaticResource MonoMediumFont}" FontSize="12" />
                    </Border>
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="6,2"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10,0,10,8">
                      <TextBlock Text="{x:Bind Meta}" FontFamily="{StaticResource MonoMediumFont}" FontSize="10"
                                 Foreground="{StaticResource TextMutedBrush}" />
                    </Border>
                  </Grid>
                  <TextBlock Text="{x:Bind Route}" Style="{StaticResource BodyStrongText}" FontSize="13"
                             TextWrapping="Wrap" Margin="0,4,0,0" />
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Ellipse Width="7" Height="7" Fill="{x:Bind StateTone}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind State}" Style="{StaticResource BodyText}" FontSize="12"
                               Foreground="{x:Bind StateTone}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- ── Selected container ───────────────────────────────── -->
      <utu:CardContentControl Style="{StaticResource PanelCard}" Grid.Column="1" Padding="22,20" VerticalAlignment="Top">
        <StackPanel Spacing="16">
          <StackPanel Spacing="5">
            <TextBlock Text="{x:Bind SelectedId, Mode=OneWay}" FontFamily="{StaticResource MonoMediumFont}" FontSize="20" />
            <TextBlock Text="{x:Bind SelectedMeta, Mode=OneWay}" Style="{StaticResource CaptionText}" FontSize="12.5"
                       TextWrapping="Wrap" />
          </StackPanel>

          <Image x:Name="SelectedIso" Height="150" Stretch="Uniform" />

          <StackPanel Spacing="10">
            <TextBlock Text="JOURNEY" FontFamily="{StaticResource BodyStrongFont}" FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}" />
            <ItemsControl ItemsSource="{x:Bind Journey, Mode=OneWay}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><controls:EvenRowPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:JourneyStep">
                  <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                      <Border Width="30" Height="30" CornerRadius="15" Background="{x:Bind Background}"
                              BorderBrush="{x:Bind Border}" BorderThickness="1.5">
                        <shapes:Path Data="{x:Bind Icon}" Stroke="{x:Bind Foreground}" StrokeThickness="1.8"
                                     Width="15" Height="15" Stretch="Uniform" />
                      </Border>
                      <TextBlock Text="{x:Bind Label}" FontFamily="{StaticResource BodyMediumFont}" FontSize="10.5"
                                 Foreground="{x:Bind LabelTone}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <Rectangle Grid.Column="1" Height="1.5" Fill="{x:Bind Connector}" Margin="4,0,4,20"
                               VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <Border Height="1" Background="{StaticResource HairlineBrush}" />
          <ItemsControl ItemsSource="{x:Bind Facts, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><controls:TwoColumnPanel ColumnSpacing="14" RowSpacing="11" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:Fact">
                <StackPanel Spacing="3">
                  <TextBlock Text="{x:Bind Key}" Style="{StaticResource MicroText}" />
                  <TextBlock Text="{x:Bind Value}" Style="{StaticResource BodyStrongText}" FontSize="13"
                             TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Button Style="{StaticResource PrimaryButton}" Click="OnOpenScanner" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <shapes:Path Data="M4 8V5a1 1 0 011-1h3M16 4h3a1 1 0 011 1v3M20 16v3a1 1 0 01-1 1h-3M8 20H5a1 1 0 01-1-1v-3M3 12h18"
                           Stroke="{StaticResource PaperBrush}" StrokeThickness="2" Width="14" Height="14"
                           Stretch="Uniform" VerticalAlignment="Center" />
              <TextBlock Text="Scan container" FontFamily="{StaticResource BodyMediumFont}" FontSize="12.5"
                         Foreground="{StaticResource PaperBrush}" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource GhostButton}" Content="Inspection record →"
                  Command="{x:Bind State.OpenInspectionCommand}" HorizontalAlignment="Stretch" />
        </StackPanel>
      </utu:CardContentControl>
    </Grid>
  </Grid>
</UserControl>
