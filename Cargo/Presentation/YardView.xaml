<UserControl x:Class="Cargo.Presentation.YardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Cargo.Presentation"
             xmlns:controls="using:Cargo.Controls"
             xmlns:utu="using:Uno.Toolkit.UI">

  <Grid Style="{StaticResource SectionFrame}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="4">
        <TextBlock Text="Yard" Style="{StaticResource SectionHeadText}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Ellipse Width="6" Height="6" Fill="{StaticResource AlertBrush}" VerticalAlignment="Center" />
          <TextBlock Text="{x:Bind LiveLine, Mode=OneWay}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
          <ItemsControl x:Name="OccupancyTicks" Height="10" VerticalAlignment="Center" />
          <TextBlock Text="{x:Bind OccupancyLine, Mode=OneWay}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="Darker tops are taller stacks. Select a stack to see its tiers." Style="{StaticResource CaptionText}" />
      </StackPanel>
      <ItemsControl Grid.Column="1" ItemsSource="{x:Bind Legend}" VerticalAlignment="Bottom">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="14" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:LegendItem">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{x:Bind Swatch}" VerticalAlignment="Center" />
              <TextBlock Text="{x:Bind Label}" Style="{StaticResource CaptionText}" FontSize="12" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>

    <Grid Grid.Row="1" ColumnSpacing="18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="PanelColumn" Width="0" />
      </Grid.ColumnDefinitions>

      <Border CornerRadius="18" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
              Background="{StaticResource LandBrush}" VerticalAlignment="Top">
        <ContentControl x:Name="MapHost" HorizontalContentAlignment="Stretch" />
      </Border>

      <utu:CardContentControl Style="{StaticResource PanelCard}" x:Name="StackPanelCard" Grid.Column="1" Padding="22,20" VerticalAlignment="Top"
                     Visibility="Collapsed">
        <StackPanel Spacing="14">
          <Grid>
            <StackPanel Spacing="3">
              <TextBlock Text="{x:Bind SlotTitle, Mode=OneWay}" FontFamily="{StaticResource BodyStrongFont}" FontSize="17" />
              <TextBlock Text="{x:Bind SlotSubtitle, Mode=OneWay}" Style="{StaticResource CaptionText}" />
            </StackPanel>
            <Button Style="{StaticResource BareButton}" Content="×" Click="OnCloseStack"
                    HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="18"
                    Foreground="{StaticResource TextFaintBrush}" />
          </Grid>

          <ContentControl x:Name="TiersHost" HorizontalContentAlignment="Stretch" />

          <Border Height="1" Background="{StaticResource HairlineBrush}" />
          <ItemsControl ItemsSource="{x:Bind Tiers, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:TierRow">
                <Grid>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="{x:Bind Tone}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind Id}" FontFamily="{StaticResource MonoMediumFont}" FontSize="12" />
                  </StackPanel>
                  <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </utu:CardContentControl>
    </Grid>
  </Grid>
</UserControl>
