<UserControl x:Class="Cargo.Presentation.FleetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Cargo.Presentation"
             xmlns:controls="using:Cargo.Controls"
             xmlns:shapes="using:Microsoft.UI.Xaml.Shapes">

  <Grid Padding="40,28,40,48" MinWidth="1040" MaxWidth="1520" RowSpacing="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Ellipse Width="6" Height="6" Fill="{StaticResource AlertBrush}" VerticalAlignment="Center" />
          <TextBlock Text="LIVE AIS · WESTHAVEN SOUND → ALDER RIVER · 120 KM" Style="{StaticResource EyebrowText}" />
        </StackPanel>
        <TextBlock Text="Fleet &amp; waterways" Style="{StaticResource PageTitleText}" />
      </StackPanel>
      <ItemsControl Grid.Column="1" ItemsSource="{x:Bind Legend}" VerticalAlignment="Bottom">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="14" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:LegendItem">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Ellipse Width="10" Height="10" Fill="{x:Bind Swatch}" VerticalAlignment="Center" />
              <TextBlock Text="{x:Bind Label}" Style="{StaticResource CaptionText}" FontSize="12" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>

    <Grid Grid.Row="1" ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="340" />
      </Grid.ColumnDefinitions>

      <StackPanel Spacing="16">
        <Border CornerRadius="18" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                Background="{StaticResource LandBrush}">
          <ContentControl x:Name="RiverHost" HorizontalContentAlignment="Stretch" />
        </Border>

        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <controls:Card>
            <StackPanel Spacing="12">
              <Grid>
                <TextBlock Text="Lockings today" Style="{StaticResource CardTitleText}" />
                <TextBlock Text="{x:Bind BookedLabel, Mode=OneWay}" Style="{StaticResource CaptionText}" FontSize="11.5"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
              <ItemsControl ItemsSource="{x:Bind Lockings}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="9" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:LockingRow">
                    <Grid ColumnSpacing="10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{x:Bind Time}" FontFamily="{StaticResource MonoMediumFont}" FontSize="12"
                                 Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Style="{StaticResource BodyText}" VerticalAlignment="Center">
                        <Run Text="{x:Bind Lock}" FontFamily="{StaticResource BodyStrongFont}" /><Run Text=" · " /><Run Text="{x:Bind Vessel}" />
                      </TextBlock>
                      <Border Grid.Column="2" Background="{x:Bind Background}" CornerRadius="99" Padding="8,3">
                        <TextBlock Text="{x:Bind State}" FontFamily="{StaticResource BodyMediumFont}" FontSize="11"
                                   Foreground="{x:Bind Foreground}" />
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </controls:Card>

          <controls:Card Grid.Column="1">
            <StackPanel Spacing="12">
              <Grid>
                <TextBlock Text="Water levels" Style="{StaticResource CardTitleText}" />
                <TextBlock Text="24 h · gauges" Style="{StaticResource CaptionText}" FontSize="11.5"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
              <ItemsControl ItemsSource="{x:Bind Gauges}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:GaugeRow">
                    <Grid ColumnSpacing="10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Style="{StaticResource BodyText}" VerticalAlignment="Center">
                        <Run Text="{x:Bind Name}" /><Run Text="{x:Bind Chainage}" Foreground="{StaticResource TextFaintBrush}" />
                      </TextBlock>
                      <shapes:Path Grid.Column="1" Data="{x:Bind Spark}" Stroke="{x:Bind Tone}"
                                   StrokeThickness="1.6" Width="90" Height="22" Stretch="Uniform"
                                   VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{x:Bind Level}" FontFamily="{StaticResource MonoMediumFont}"
                                 FontSize="12" Foreground="{x:Bind Tone}" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </controls:Card>

          <controls:Card Grid.Column="2">
            <StackPanel Spacing="12">
              <Grid>
                <TextBlock Text="Notices to skippers" Style="{StaticResource CardTitleText}" />
                <TextBlock Text="{x:Bind NoticeCount}" Style="{StaticResource CaptionText}" FontSize="11.5"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
              <ItemsControl ItemsSource="{x:Bind Notices}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:NoticeRow">
                    <Grid ColumnSpacing="10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border Width="16" Height="16" CornerRadius="8" BorderThickness="2" BorderBrush="{x:Bind Tone}"
                              VerticalAlignment="Top" Margin="0,1,0,0">
                        <TextBlock Text="!" FontFamily="{StaticResource BodyStrongFont}" FontSize="9"
                                   Foreground="{x:Bind Tone}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                   LineHeight="18" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </controls:Card>
        </Grid>
      </StackPanel>

      <!-- ── Underway + crew ─────────────────────────────────────── -->
      <StackPanel Grid.Column="1" Spacing="12">
        <controls:Card Padding="18,16">
          <StackPanel Spacing="10">
            <Grid>
              <TextBlock Text="Underway" Style="{StaticResource CardTitleText}" />
              <TextBlock Text="{x:Bind FleetCount}" Style="{StaticResource CaptionText}" FontSize="11.5"
                         HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <ItemsControl ItemsSource="{x:Bind Fleet, Mode=OneWay}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:FleetRow">
                  <Button Style="{StaticResource RowButton}" Command="{x:Bind Select}" CommandParameter="{x:Bind Id}">
                    <Border Background="{x:Bind Background}" BorderBrush="{x:Bind Border}" BorderThickness="1"
                            CornerRadius="12" Padding="12,10">
                      <Grid ColumnSpacing="10" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="7">
                          <Ellipse Width="7" Height="7" Fill="{x:Bind Tone}" VerticalAlignment="Center" />
                          <TextBlock Text="{x:Bind Name}" FontFamily="{StaticResource BodyStrongFont}" FontSize="13" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind Slip}" FontFamily="{StaticResource MonoMediumFont}"
                                   FontSize="12" Foreground="{x:Bind Tone}" />
                        <TextBlock Grid.Row="1" Text="{x:Bind Detail}" Style="{StaticResource CaptionText}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Eta}" Style="{StaticResource MicroText}" />
                      </Grid>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </controls:Card>

        <controls:Card Padding="18,16" Background="{StaticResource InkBrush}" BorderBrush="{StaticResource InkBrush}">
          <StackPanel Spacing="12">
            <Grid>
              <StackPanel Spacing="3">
                <TextBlock Text="{x:Bind CrewHeading, Mode=OneWay}" Style="{StaticResource CardTitleText}"
                           Foreground="{StaticResource PaperBrush}" />
                <TextBlock Text="{x:Bind CrewSubtitle, Mode=OneWay}" Style="{StaticResource CaptionText}"
                           Foreground="{StaticResource TextOnDarkMutedBrush}" />
              </StackPanel>
              <Border Background="{x:Bind SlipBackground, Mode=OneWay}" CornerRadius="99" Padding="9,4"
                      HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock Text="{x:Bind SlipLabel, Mode=OneWay}" FontFamily="{StaticResource BodyMediumFont}"
                           FontSize="11" Foreground="{x:Bind SlipTone, Mode=OneWay}" />
              </Border>
            </Grid>

            <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{x:Bind Thread, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:ChatBubble">
                    <StackPanel HorizontalAlignment="{x:Bind Align}" Spacing="3">
                      <Border Background="{x:Bind Background}" CornerRadius="12" Padding="11,8" MaxWidth="240">
                        <TextBlock Text="{x:Bind Text}" Style="{StaticResource BodyText}" Foreground="{x:Bind Foreground}"
                                   TextWrapping="Wrap" LineHeight="18" />
                      </Border>
                      <TextBlock Text="{x:Bind Meta}" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                 Foreground="{StaticResource TextFaintBrush}" HorizontalAlignment="{x:Bind Align}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <ItemsControl ItemsSource="{x:Bind QuickMessages, Mode=OneWay}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><controls:TileGridPanel MinTileWidth="130" Gap="6" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:QuickMessage">
                  <Button Style="{StaticResource BareButton}" Command="{x:Bind Send}" CommandParameter="{x:Bind Text}">
                    <Border BorderBrush="{StaticResource HairlineOnDarkBrush}" BorderThickness="1" CornerRadius="99"
                            Padding="10,6">
                      <TextBlock Text="{x:Bind Label}" FontFamily="{StaticResource BodyMediumFont}" FontSize="11.5"
                                 Foreground="{StaticResource TealPaleBrush}" HorizontalAlignment="Center" />
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="ChatBox" PlaceholderText="Message the crew…" CornerRadius="10"
                       Background="{StaticResource HairlineOnDarkBrush}" Foreground="{StaticResource PaperBrush}"
                       BorderBrush="{StaticResource HairlineOnDarkBrush}" FontSize="12.5" Padding="12,10"
                       KeyDown="OnChatKeyDown" />
              <Button Grid.Column="1" Style="{StaticResource AccentButton}" Content="Send" Click="OnSendClick"
                      Padding="16,10" />
            </Grid>
          </StackPanel>
        </controls:Card>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
