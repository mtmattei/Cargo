<Page x:Class="Cargo.Presentation.FleetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Cargo.Presentation"
             xmlns:controls="using:Cargo.Controls"
             xmlns:shapes="using:Microsoft.UI.Xaml.Shapes"
             xmlns:utu="using:Uno.Toolkit.UI">

  <Grid Style="{StaticResource PageFrame}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ── Masthead ─────────────────────────────────────────────── -->
    <Grid Style="{StaticResource Masthead}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel VerticalAlignment="Bottom" Spacing="8">
        <TextBlock Text="Fleet &amp; waterways" Style="{StaticResource PageTitleText}" />
        <StackPanel Orientation="Horizontal" Spacing="7">
          <Ellipse Width="6" Height="6" Fill="{StaticResource AlertInvariantBrush}" VerticalAlignment="Center" />
          <TextBlock Text="Live AIS · Westhaven Sound to the Alder River · 120 km" Style="{StaticResource PageSubtitleText}" />
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="26" VerticalAlignment="Bottom">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{x:Bind ViewModel.UnderwayCount, Mode=OneWay}" Style="{StaticResource MetricText}" />
          <TextBlock Text="underway" Style="{StaticResource MetricLabelText}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{x:Bind ViewModel.LateCount, Mode=OneWay}" Style="{StaticResource MetricText}" Foreground="{StaticResource OrangeInkInvariantBrush}" />
          <TextBlock Text="running late" Style="{StaticResource MetricLabelText}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{x:Bind ViewModel.LockCount, Mode=OneWay}" Style="{StaticResource MetricText}" />
          <TextBlock Text="lockings booked" Style="{StaticResource MetricLabelText}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{x:Bind ViewModel.NoticeTotal, Mode=OneWay}" Style="{StaticResource MetricText}" Foreground="{StaticResource AlertInvariantBrush}" />
          <TextBlock Text="notices" Style="{StaticResource MetricLabelText}" />
        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- ── Row 1: the river + underway ─────────────────────────── -->
    <Grid Grid.Row="1" ColumnSpacing="40">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="300" />
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource RuledPanel}" Padding="0,18,0,14">
        <StackPanel Spacing="12">
          <Grid ColumnSpacing="18">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Alder River" Style="{StaticResource CardTitleText}" VerticalAlignment="Center" />
            <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.Legend, Mode=OneWay}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="14" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:LegendItem">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="7" Height="7" Fill="{x:Bind Swatch}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource CaptionText}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
          <!-- xaml-lint: allow card - the river chart's ground, not a card -->
          <Border CornerRadius="{StaticResource RadiusPanel}" Background="{StaticResource LandInvariantBrush}">
            <ContentControl x:Name="RiverHost" HorizontalContentAlignment="Stretch" />
          </Border>
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource RuledPanel}" Padding="0,18,0,14">
        <StackPanel Spacing="14">
          <Grid>
            <TextBlock Text="Underway" Style="{StaticResource PanelTitleText}" />
            <TextBlock Text="{x:Bind ViewModel.FleetCount, Mode=OneWay}" Style="{StaticResource CaptionText}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
          <ItemsControl ItemsSource="{x:Bind ViewModel.Fleet, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:FleetRow">
                <Button Style="{StaticResource RowButton}" Command="{x:Bind Select}" CommandParameter="{x:Bind Id}"
                        AutomationProperties.Name="{x:Bind Name}">
                  <!-- xaml-lint: allow card - the selected-row highlight, not a card -->
                  <Border Background="{x:Bind Background}" CornerRadius="{StaticResource RadiusControl}" Padding="10,8">
                    <Grid ColumnSpacing="10" RowSpacing="3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Width="6" Height="6" Fill="{x:Bind Tone}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongText}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{x:Bind Slip}" Style="{StaticResource TypeMonoMedium12}" Foreground="{x:Bind SlipInk}" />
                      <TextBlock Grid.Row="1" Text="{x:Bind Detail}" Style="{StaticResource CaptionText}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Eta}" Style="{StaticResource CaptionText}"
                                 FontFamily="{StaticResource MonoFont}" />
                    </Grid>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ── Row 2: lockings, gauges, notices, crew ───────────────── -->
    <Grid Grid.Row="2" ColumnSpacing="40">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="300" />
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource RuledPanel}" Padding="0,18,0,14">
        <StackPanel Spacing="14">
          <StackPanel Spacing="3">
            <TextBlock Text="Lockings today" Style="{StaticResource CardTitleText}" />
            <TextBlock Text="{x:Bind ViewModel.BookedLabel, Mode=OneWay}" Style="{StaticResource CaptionText}" />
          </StackPanel>
          <ItemsControl ItemsSource="{x:Bind ViewModel.Lockings, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:LockingRow">
                <Grid ColumnSpacing="10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{x:Bind Time}" Style="{StaticResource TypeMonoMedium12}"
                             Foreground="{StaticResource TextMutedInvariantBrush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Style="{StaticResource BodyText}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis">
                    <Run Text="{x:Bind Lock}" FontFamily="{StaticResource BodyStrongFont}" /><Run Text=" · " /><Run Text="{x:Bind Vessel}" />
                  </TextBlock>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="6" Height="6" Fill="{x:Bind Tone}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind State}" Style="{StaticResource StatusText}" Foreground="{x:Bind Ink}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource RuledPanel}" Padding="0,18,0,14">
        <StackPanel Spacing="14">
          <StackPanel Spacing="3">
            <TextBlock Text="Water levels" Style="{StaticResource CardTitleText}" />
            <TextBlock Text="Gauges · last 24 h" Style="{StaticResource CaptionText}" />
          </StackPanel>
          <ItemsControl ItemsSource="{x:Bind ViewModel.Gauges, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:GaugeRow">
                <Grid ColumnSpacing="10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="64" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongText}" />
                    <TextBlock Text="{x:Bind Chainage}" Style="{StaticResource CaptionText}" />
                  </StackPanel>
                  <!-- Water level: the river's colour over a fade to the baseline -->
                  <Grid Grid.Column="1" Width="80" Height="22" VerticalAlignment="Center">
                    <shapes:Path Data="{x:Bind SparkArea}" Fill="{StaticResource WaterFadeInvariantBrush}" />
                    <shapes:Path Data="{x:Bind Spark}" Stroke="{StaticResource WaterLineInvariantBrush}" StrokeThickness="1.6"
                                 StrokeLineJoin="Round" />
                  </Grid>
                  <TextBlock Grid.Column="2" Text="{x:Bind Level}" Style="{StaticResource TypeMonoMedium12}" Foreground="{x:Bind Ink}" VerticalAlignment="Center" TextAlignment="Right" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource RuledPanel}" Padding="0,18,0,14">
        <StackPanel Spacing="14">
          <StackPanel Spacing="3">
            <TextBlock Text="Notices to skippers" Style="{StaticResource CardTitleText}" />
            <TextBlock Text="{x:Bind ViewModel.NoticeCount, Mode=OneWay}" Style="{StaticResource CaptionText}" />
          </StackPanel>
          <ItemsControl ItemsSource="{x:Bind ViewModel.Notices, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:NoticeRow">
                <Grid ColumnSpacing="9">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Ellipse Width="6" Height="6" Fill="{x:Bind Tone}" VerticalAlignment="Top" Margin="0,6,0,0" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" LineHeight="17" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Crew channel for the vessel selected under Underway -->
      <Border Grid.Column="3" Style="{StaticResource RuledPanel}" Padding="0,18,0,14">
        <StackPanel Spacing="12">
          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
              <TextBlock Text="{x:Bind ViewModel.CrewHeading, Mode=OneWay}" Style="{StaticResource CardTitleText}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{x:Bind ViewModel.CrewSubtitle, Mode=OneWay}" Style="{StaticResource CaptionText}"
                         TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top" Margin="0,3,0,0">
              <Ellipse Width="6" Height="6" Fill="{x:Bind ViewModel.SlipTone, Mode=OneWay}" VerticalAlignment="Center" />
              <TextBlock Text="{x:Bind ViewModel.SlipLabel, Mode=OneWay}" Style="{StaticResource StatusText}"
                         Foreground="{x:Bind ViewModel.SlipInk, Mode=OneWay}" />
            </StackPanel>
          </Grid>

          <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Thread, Mode=OneWay}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:ChatBubble">
                  <StackPanel HorizontalAlignment="{x:Bind Align}" Spacing="3">
                    <!-- xaml-lint: allow card - a chat bubble, not a card -->
                    <Border Background="{x:Bind Background}" CornerRadius="{StaticResource RadiusPanel}" Padding="11,8" MaxWidth="240">
                      <TextBlock Text="{x:Bind Text}" Style="{StaticResource BodyText}" Foreground="{x:Bind Foreground}"
                                 TextWrapping="Wrap" LineHeight="18" />
                    </Border>
                    <TextBlock Text="{x:Bind Meta}" Style="{StaticResource TypeMono11}"
                               Foreground="{StaticResource TextMutedInvariantBrush}" HorizontalAlignment="{x:Bind Align}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <ItemsControl ItemsSource="{x:Bind ViewModel.QuickMessages, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:QuickMessage">
                <Button Style="{StaticResource GhostButton}" Command="{x:Bind Send}" CommandParameter="{x:Bind Text}"
                        Content="{x:Bind Label}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="12,8" CornerRadius="{StaticResource RadiusControl}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Enter sends: CommandExtensions runs the command on Enter for a TextBox -->
            <TextBox PlaceholderText="Message the crew…" CornerRadius="{StaticResource RadiusControl}"
                     Padding="12,9" AutomationProperties.Name="Message the crew"
                     Text="{x:Bind ViewModel.State.ChatDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     utu:CommandExtensions.Command="{x:Bind ViewModel.SendDraftCommand, Mode=OneWay}" />
            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Send" Command="{x:Bind ViewModel.SendDraftCommand, Mode=OneWay}"
                    CornerRadius="{StaticResource RadiusControl}" />
          </Grid>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ── Sea & weather and the night's tide ─────────────────────── -->
    <local:SeaWeatherPanel Grid.Row="3" DataContext="{x:Bind ViewModel.State}" />
  </Grid>
</Page>
