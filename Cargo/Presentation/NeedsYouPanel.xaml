<UserControl x:Class="Cargo.Presentation.NeedsYouPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Cargo.Presentation"
             xmlns:domain="using:Cargo.Domain"
             xmlns:shapes="using:Microsoft.UI.Xaml.Shapes">

  <!-- The Needs-you queue: what waits on the dispatcher, each with the action that resolves it.
       The section is tinted alert while anything is open; empty, it keeps its height and says so. -->
  <Grid x:Name="Section" Padding="24,24,24,16" CornerRadius="12,12,0,0"
        Background="{x:Bind local:NeedsYouPanel.Ground(ViewModel.NeedsYouCount), Mode=OneWay}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" Spacing="10">
      <TextBlock x:Name="Heading" Text="Needs you" Style="{StaticResource PanelHeadingText}" VerticalAlignment="Center"
                 IsTabStop="True" AutomationProperties.HeadingLevel="Level2"
                 AutomationProperties.Name="{x:Bind local:NeedsYouPanel.Spoken(ViewModel.NeedsYouCount), Mode=OneWay}" />
      <!-- xaml-lint: allow card - the count badge, a pill of mono digits -->
      <Border Background="{StaticResource AlertInkInvariantBrush}" CornerRadius="12" Padding="10,4" VerticalAlignment="Center"
              Visibility="{x:Bind local:NeedsYouPanel.Shown(ViewModel.NeedsYouCount), Mode=OneWay}"
              AutomationProperties.AccessibilityView="Raw">
        <TextBlock Text="{x:Bind local:NeedsYouPanel.Count(ViewModel.NeedsYouCount), Mode=OneWay}" Style="{StaticResource CountBadgeText}" />
      </Border>
    </StackPanel>

    <TextBlock Grid.Row="1" Text="Nothing needs you" Style="{StaticResource SubtitleText}" Margin="0,16,0,0"
               Visibility="{x:Bind local:NeedsYouPanel.Empty(ViewModel.NeedsYouCount), Mode=OneWay}" />

    <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.Decisions}" Margin="0,4,0,0" IsTabStop="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="domain:Decision">
          <Grid ColumnSpacing="12" Padding="0,16" BorderBrush="{StaticResource HairlineInvariantBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="20" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Viewbox Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,0,0" AutomationProperties.AccessibilityView="Raw">
              <Grid Width="24" Height="24">
                <shapes:Path Style="{x:Bind local:NeedsYouPanel.Icon(Kind)}" Stroke="{StaticResource AlertInvariantBrush}" />
              </Grid>
            </Viewbox>

            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{x:Bind Title}" Style="{StaticResource TitleText}" TextWrapping="Wrap" />
              <TextBlock Style="{StaticResource SubtitleText}" TextWrapping="Wrap">
                <Run Text="{x:Bind Sub}" /><Run Text="{x:Bind local:NeedsYouPanel.Separator(When), Mode=OneWay}" /><Run Text="{x:Bind When, Mode=OneWay}"
                     Foreground="{x:Bind local:NeedsYouPanel.WhenInk(IsLate), Mode=OneWay}"
                     FontFamily="{x:Bind local:NeedsYouPanel.WhenFace(IsLate), Mode=OneWay}" />
              </TextBlock>
            </StackPanel>

            <Button Grid.Column="2" Content="{x:Bind ActionLabel}" Style="{x:Bind local:NeedsYouPanel.Action(IsPrimary)}"
                    Command="{x:Bind Command}" CommandParameter="{x:Bind CommandParameter}" VerticalAlignment="Center" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</UserControl>
