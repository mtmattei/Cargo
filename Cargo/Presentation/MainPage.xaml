<Page x:Class="Cargo.Presentation.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Cargo.Presentation"
      xmlns:harbour="using:Cargo.Controls.Harbour"
      xmlns:controls="using:Cargo.Controls"
      xmlns:shapes="using:Microsoft.UI.Xaml.Shapes"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{StaticResource PaperInvariantBrush}">

  <Page.Resources>
    <!-- Harbour HUD breakpoint: below 1040 the layer switcher stacks above the camera presets -->
    <utu:ResponsiveLayout x:Key="HudBreakpoints" Narrowest="0" Narrow="0" Normal="1040" Wide="100000" Widest="100000" />
  </Page.Resources>

  <!-- Two layers: the page, and the inspection over the whole window. The overlay stays out of the
       page rows so its size never feeds the Auto stage row. -->
  <Grid>
  <Grid uen:Region.Attached="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="56" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ══ HEADER ══════════════════════════════════════════════════════ -->
    <Grid Grid.Row="0" Background="{StaticResource SurfaceInvariantBrush}"
          BorderBrush="{StaticResource HairlineInvariantBrush}" BorderThickness="0,0,0,1"
          Padding="40,0,28,0" ColumnSpacing="28">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Text="Westhaven" Style="{StaticResource WordmarkText}" VerticalAlignment="Center" />

      <!-- Sections: text tabs; a section with something waiting on you carries an alert dot -->
      <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.NavItems, Mode=OneWay}" VerticalAlignment="Stretch">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:NavItem">
            <Button Style="{StaticResource NavTabButton}" uen:Navigation.Request="{x:Bind Route}"
                    Foreground="{x:Bind LabelForeground, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneWay}">
              <Grid>
                <StackPanel Orientation="Horizontal" Spacing="5" Margin="12,0" VerticalAlignment="Center">
                  <TextBlock Text="{x:Bind Label}" Style="{StaticResource TypeStrong14}"
                             Visibility="{x:Bind CurrentVisibility, Mode=OneWay}" />
                  <TextBlock Text="{x:Bind Label}" Style="{StaticResource TypeMedium14}"
                             Visibility="{x:Bind OtherVisibility, Mode=OneWay}" />
                  <Ellipse Width="6" Height="6" Fill="{StaticResource AlertInvariantBrush}" VerticalAlignment="Top"
                           Margin="0,1,0,0" Visibility="{x:Bind NeedsVisibility, Mode=OneWay}" />
                </StackPanel>
                <Rectangle Height="2" VerticalAlignment="Bottom" Fill="{StaticResource AccentInvariantBrush}"
                           Opacity="{x:Bind UnderlineOpacity, Mode=OneWay}" />
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <!-- Minutes roll; seconds tick plainly -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind ViewModel.State.Now, Mode=OneWay}">
          <controls:RollingText Text="{x:Bind ViewModel.State.NowMinutes, Mode=OneWay}" Style="{StaticResource HeaderClockFigure}" />
          <TextBlock Text="{x:Bind ViewModel.State.NowSeconds, Mode=OneWay}" Style="{StaticResource HeaderClockText}" />
        </StackPanel>

        <!-- Account: who is on shift, and the reduced-motion setting (Skia desktop always reports
             animations enabled, so the app keeps its own) -->
        <Button Style="{StaticResource BareButton}" Width="44" Height="44"
                AutomationProperties.Name="{x:Bind ViewModel.AccountName}"
                ToolTipService.ToolTip="{x:Bind ViewModel.AccountName}">
          <Grid>
            <Ellipse Width="32" Height="32" Fill="{StaticResource AccentInvariantBrush}" />
            <TextBlock Text="{x:Bind ViewModel.Operator.Initials}" Style="{StaticResource AvatarInitialsText}" />
          </Grid>
          <Button.Flyout>
            <!-- A Flyout, not a MenuFlyout: the operator's name and shift are information, and a
                 MenuFlyout can only show them as disabled (unreadable) items -->
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Width="240" Spacing="12">
                <StackPanel Spacing="3">
                  <TextBlock Text="{x:Bind ViewModel.Operator.Name}" Style="{StaticResource TitleText}" />
                  <TextBlock Text="{x:Bind ViewModel.OperatorLine}" Style="{StaticResource SubtitleText}" TextWrapping="Wrap" />
                </StackPanel>
                <Rectangle Height="1" Fill="{StaticResource HairlineInvariantBrush}" />
                <ToggleSwitch Header="Reduce motion" IsOn="{x:Bind ViewModel.ReduceMotion, Mode=TwoWay}"
                              ToolTipService.ToolTip="Hold the cranes, trucks and camera moves still" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
    </Grid>

    <!-- ══ SHARED HARBOUR STAGE ════════════════════════════════════════ -->
    <Grid x:Name="StageHost" Grid.Row="1" Background="{StaticResource HarbourStageInvariantBrush}"
          Visibility="{x:Bind ViewModel.State.ShowStage, Mode=OneWay}">
      <!-- One harbour for every harbour page: the wide stage on Overview, a strip framed by the section elsewhere -->
      <harbour:HarbourView x:Name="Harbour" Compact="{x:Bind ViewModel.State.StageCompact, Mode=OneWay}" />
      <!-- Overview greeting, laid over the top of the stage on its light field. The harbour frames itself
           below the greeting's height (HarbourView.TopInset), so it covers no ship, tag or HUD. -->
      <local:OverviewMasthead x:Name="Masthead" DataContext="{x:Bind ViewModel.Overview, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsOverview, Mode=OneWay}"
                              VerticalAlignment="Top" Margin="24,20,24,0" />
      <!-- Layer switcher: centred on the HUD row; below Normal (1040) the row cannot hold presets, layers and
           zoom (292 + 330 + 266 px plus gutters), so it stacks above the camera presets (16 + 36 + 8 px up) -->
      <Border Style="{StaticResource HarbourHudPanel}" Padding="3" VerticalAlignment="Bottom"
              HorizontalAlignment="{utu:Responsive Layout={StaticResource HudBreakpoints}, Narrow=Left, Normal=Center}"
              Margin="{utu:Responsive Layout={StaticResource HudBreakpoints}, Narrow='24,0,0,60', Normal='0,0,0,16'}"
              Visibility="{x:Bind ViewModel.State.StageFull, Mode=OneWay}">
        <ItemsControl ItemsSource="{x:Bind ViewModel.Layers, Mode=OneWay}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:LayerItem">
              <Button Style="{StaticResource BareButton}" Command="{x:Bind Command}" CommandParameter="{x:Bind Id}"
                      ToolTipService.ToolTip="{x:Bind Label}">
                <!-- xaml-lint: allow card - the current-segment highlight of a segmented control, not a card -->
                <Border Background="{x:Bind Background}" CornerRadius="6" Padding="11,7">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <shapes:Path Data="{x:Bind Icon}" Stroke="{x:Bind Foreground}" StrokeThickness="1.8"
                                 Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind Label}" FontFamily="{StaticResource BodyMediumFont}" FontSize="13"
                               Foreground="{x:Bind Foreground}" />
                  </StackPanel>
                </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <Button Style="{StaticResource GhostButton}" Command="{x:Bind ViewModel.State.ToggleStageCommand}"
              Content="{x:Bind ViewModel.State.StageToggleLabel, Mode=OneWay}"
              Visibility="{x:Bind ViewModel.State.ShowStageToggle, Mode=OneWay}"
              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
              Background="{StaticResource SurfaceInvariantBrush}" Padding="11,7" CornerRadius="{StaticResource RadiusControl}" />
    </Grid>

    <!-- ══ SECTION ═════════════════════════════════════════════════════ -->
    <ScrollViewer x:Name="SectionScroll" Grid.Row="2" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto"
                  VerticalScrollBarVisibility="Auto" ZoomMode="Disabled">
      <!-- Section region: one pane per route in App.RegisterRoutes. Each pane is x:Load'ed, so
           startup pays for the section you open on; the rest are realized one per idle turn after
           load (MainPage.WarmSections), and a jump to one not yet built realizes it on the spot
           (the navigator finds panes by name). x:Name and Region.Name are both the route id. -->
      <Grid x:Name="Sections" uen:Region.Attached="True" uen:Region.Navigator="Visibility">
        <!-- Overview has no minimum width: it takes the viewport's, so its charts fit instead of
             measuring at their design width inside the horizontally scrolling region -->
        <local:OverviewView x:Name="overview" x:Load="False" uen:Region.Name="overview" Visibility="Collapsed"
                            Width="{x:Bind SectionScroll.ViewportWidth, Mode=OneWay}"
                            DataContext="{x:Bind ViewModel.Overview, Mode=OneWay}" />
        <local:BerthsView x:Name="berths" x:Load="False" uen:Region.Name="berths" Visibility="Collapsed"
                          DataContext="{x:Bind ViewModel.Berths, Mode=OneWay}" />
        <local:CargoView x:Name="cargo" x:Load="False" uen:Region.Name="cargo" Visibility="Collapsed"
                         DataContext="{x:Bind ViewModel.Cargo, Mode=OneWay}" />
        <local:FleetView x:Name="fleet" x:Load="False" uen:Region.Name="fleet" Visibility="Collapsed"
                         DataContext="{x:Bind ViewModel.Fleet, Mode=OneWay}" />
        <local:SecurityView x:Name="security" x:Load="False" uen:Region.Name="security" Visibility="Collapsed"
                            DataContext="{x:Bind ViewModel.Security, Mode=OneWay}" />
      </Grid>
    </ScrollViewer>

  </Grid>

  <!-- ══ CONTAINER INSPECTION ════════════════════════════════════════ -->
  <local:ScannerOverlay DataContext="{x:Bind ViewModel.Scanner, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.State.ScannerOpen, Mode=OneWay, FallbackValue=Collapsed}" />
  </Grid>
</Page>
