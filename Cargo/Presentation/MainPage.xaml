<Page x:Class="Cargo.Presentation.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Cargo.Presentation"
      xmlns:harbour="using:Cargo.Controls.Harbour"
      xmlns:shapes="using:Microsoft.UI.Xaml.Shapes"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{StaticResource PaperInvariantBrush}">

  <Page.Resources>
    <!-- Header breakpoints: below 1040 only the section chips; from 1040 the current section's name
         and the ISPS badge; from 1280 every name plus weather and tide -->
    <utu:ResponsiveLayout x:Key="HeaderBreakpoints" Narrowest="0" Narrow="0" Normal="1040" Wide="1280" Widest="100000" />
  </Page.Resources>

  <!-- Two layers: the page, and the inspection over the whole window. The overlay stays out of the
       page rows so its size never feeds the Auto stage row. -->
  <Grid>
  <Grid uen:Region.Attached="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="56" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ══ HEADER ══════════════════════════════════════════════════════ -->
    <Grid Grid.Row="0" Background="{StaticResource InkDeepInvariantBrush}" Padding="24,0" ColumnSpacing="32">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Wordmark -->
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <shapes:Path Data="M5 13c4-5 8-5 12 0s8 5 12 0M5 21c4-5 8-5 12 0s8 5 12 0"
                     Stroke="{StaticResource TealBrightInvariantBrush}" StrokeThickness="2.6"
                     StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                     Width="26" Height="26" Stretch="Uniform" VerticalAlignment="Center" />
        <TextBlock Text="Westhaven" FontFamily="{StaticResource DisplayBoldFont}" FontSize="15"
                   Foreground="{StaticResource PaperInvariantBrush}" VerticalAlignment="Center" />
        <TextBlock Text="SHIPPING · DISPATCH" FontFamily="{StaticResource MonoMediumFont}" FontSize="10"
                   Foreground="{StaticResource TealBrightInvariantBrush}" VerticalAlignment="Center" Margin="2,1,0,0" />
      </StackPanel>

      <!-- Sections -->
      <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.NavItems, Mode=OneWay}" VerticalAlignment="Stretch">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:NavItem">
            <Button Style="{StaticResource BareButton}" uen:Navigation.Request="{x:Bind Route}"
                    ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneWay}" Height="56">
              <Grid Padding="12,0">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Grid VerticalAlignment="Center">
                    <!-- xaml-lint: allow card - the section number chip in the header -->
                    <Border Background="{x:Bind ChipBackground, Mode=OneWay}" CornerRadius="4" MinWidth="22" Height="18"
                            Padding="4,0">
                      <TextBlock Text="{x:Bind Index}" FontFamily="{StaticResource MonoMediumFont}" FontSize="10.5"
                                 Foreground="{x:Bind ChipForeground, Mode=OneWay}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <!-- Attention: a dot on the chip's corner, ringed in the header's ink so it reads on any chip -->
                    <Ellipse Width="8" Height="8" Fill="{x:Bind BadgeBrush, Mode=OneWay}" Stroke="{StaticResource InkDeepInvariantBrush}"
                             StrokeThickness="1.5" Opacity="{x:Bind BadgeOpacity, Mode=OneWay}"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0" />
                  </Grid>
                  <!-- The current section keeps its name from Normal; the others only at Wide -->
                  <Grid VerticalAlignment="Center" Visibility="{utu:Responsive Layout={StaticResource HeaderBreakpoints}, Narrow=Collapsed, Normal=Visible}">
                    <TextBlock Text="{x:Bind Label}" FontFamily="{StaticResource BodyMediumFont}" FontSize="13"
                               Foreground="{x:Bind LabelForeground, Mode=OneWay}"
                               Visibility="{x:Bind CurrentVisibility, Mode=OneWay}" />
                    <Grid Visibility="{x:Bind OtherVisibility, Mode=OneWay}">
                      <TextBlock Text="{x:Bind Label}" FontFamily="{StaticResource BodyMediumFont}" FontSize="13"
                                 Foreground="{x:Bind LabelForeground, Mode=OneWay}"
                                 Visibility="{utu:Responsive Layout={StaticResource HeaderBreakpoints}, Narrow=Collapsed, Wide=Visible}" />
                    </Grid>
                  </Grid>
                </StackPanel>
                <Rectangle Height="2" Margin="12,0,12,0" VerticalAlignment="Bottom"
                           Fill="{StaticResource TealBrightInvariantBrush}" Opacity="{x:Bind UnderlineOpacity, Mode=OneWay}" />
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Status cluster -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
        <StackPanel x:Name="IspsBadge" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"
                    Visibility="{utu:Responsive Layout={StaticResource HeaderBreakpoints}, Narrow=Collapsed, Normal=Visible}">
          <Ellipse Width="6" Height="6" Fill="{StaticResource SeaGreenInvariantBrush}" VerticalAlignment="Center" />
          <TextBlock Text="ISPS 1" Style="{StaticResource CaptionText}" Foreground="{StaticResource TextOnDarkMutedBrush}" />
        </StackPanel>

        <StackPanel x:Name="WeatherBadge" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"
                    Visibility="{utu:Responsive Layout={StaticResource HeaderBreakpoints}, Narrow=Collapsed, Wide=Visible}"
                    ToolTipService.ToolTip="Partly cloudy · sea 15 °C">
          <shapes:Path Data="M14 46h32a10 10 0 0 0 1-20 14 14 0 0 0-27 4 8 8 0 0 0-6 16z"
                       Fill="{StaticResource TextOnDarkMutedBrush}" Width="18" Height="15" Stretch="Uniform"
                       VerticalAlignment="Center" />
          <TextBlock Text="18 °C" FontFamily="{StaticResource BodyMediumFont}" FontSize="12.5"
                     Foreground="{StaticResource PaperInvariantBrush}" VerticalAlignment="Center" />
          <TextBlock Text="· sea 15 °C" Style="{StaticResource CaptionText}"
                     Foreground="{StaticResource TextOnDarkMutedBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel x:Name="TideBadge" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                    Visibility="{utu:Responsive Layout={StaticResource HeaderBreakpoints}, Narrow=Collapsed, Wide=Visible}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.Tide.Tooltip, Mode=OneWay}">
          <Grid Width="34" Height="16">
            <shapes:Path Data="{x:Bind ViewModel.Tide.Spark, Mode=OneWay}" Stroke="{StaticResource TealBrightInvariantBrush}"
                         StrokeThickness="3" Stretch="Uniform" />
          </Grid>
          <TextBlock Text="{x:Bind ViewModel.Tide.Label, Mode=OneWay}" Style="{StaticResource CaptionText}"
                     Foreground="{StaticResource TextOnDarkMutedBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Reduced motion: Skia desktop always reports animations enabled, so the app keeps its own
             setting. The rest colours are local (the style's setters resolve the keys at app level);
             the lightweight keys cover the hover, pressed and checked states. -->
        <ToggleButton IsChecked="{x:Bind ViewModel.ReduceMotion, Mode=TwoWay}"
                      Content="{x:Bind ViewModel.MotionLabel, Mode=OneWay}"
                      FontFamily="{StaticResource BodyFont}" FontSize="11.5"
                      AutomationProperties.Name="Reduce motion"
                      ToolTipService.ToolTip="Reduce motion: hold the cranes, trucks and camera moves still"
                      Padding="10,4" MinHeight="0" CornerRadius="12" BorderThickness="1" VerticalAlignment="Center"
                      Background="Transparent" Foreground="{StaticResource TextOnDarkMutedBrush}"
                      BorderBrush="{StaticResource HairlineOnDarkBrush}">
          <ToggleButton.Resources>
            <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="HairlineOnDarkBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="HairlineOnDarkBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="TealDeepInvariantBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="TealDeepInvariantBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="TealDeepInvariantBrush" />
            <StaticResource x:Key="ToggleButtonForegroundPointerOver" ResourceKey="PaperInvariantBrush" />
            <StaticResource x:Key="ToggleButtonForegroundPressed" ResourceKey="PaperInvariantBrush" />
            <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="PaperInvariantBrush" />
            <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="PaperInvariantBrush" />
            <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="PaperInvariantBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="HairlineOnDarkBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="HairlineOnDarkBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="TealDeepInvariantBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="TealDeepInvariantBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="TealDeepInvariantBrush" />
          </ToggleButton.Resources>
        </ToggleButton>

        <Rectangle Width="1" Height="20" Fill="{StaticResource HairlineOnDarkBrush}" VerticalAlignment="Center" />

        <TextBlock Text="{x:Bind ViewModel.State.Now, Mode=OneWay}" FontFamily="{StaticResource MonoMediumFont}"
                   FontSize="13" Foreground="{StaticResource PaperInvariantBrush}" VerticalAlignment="Center" />

        <!-- xaml-lint: allow card - user avatar -->
        <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource TealDeepInvariantBrush}">
          <TextBlock Text="EL" FontFamily="{StaticResource BodyStrongFont}" FontSize="10.5"
                     Foreground="{StaticResource SurfaceInvariantBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </StackPanel>
    </Grid>

    <!-- ══ SHARED HARBOUR STAGE ════════════════════════════════════════ -->
    <Grid x:Name="StageHost" Grid.Row="1" Background="{StaticResource HarbourStageInvariantBrush}"
          Visibility="{x:Bind ViewModel.State.ShowStage, Mode=OneWay}">
      <!-- One harbour for every harbour page: the wide stage on Overview, a strip framed by the section elsewhere -->
      <harbour:HarbourView x:Name="Harbour" Compact="{x:Bind ViewModel.State.StageCompact, Mode=OneWay}" />
      <!-- Overview greeting, laid over the top of the stage on its light field. The harbour frames itself
           below the greeting's height (HarbourView.TopInset), so it covers no ship, tag or HUD. -->
      <local:OverviewMasthead x:Name="Masthead" DataContext="{x:Bind ViewModel.Overview, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsOverview, Mode=OneWay}"
                              VerticalAlignment="Top" Margin="24,20,24,0" />
      <!-- Layer switcher: centred on the HUD row; below Normal (1040) the row cannot hold presets, layers and
           zoom (292 + 330 + 266 px plus gutters), so it stacks above the camera presets (16 + 36 + 8 px up) -->
      <Border Style="{StaticResource HarbourHudPanel}" Padding="3" VerticalAlignment="Bottom"
              HorizontalAlignment="{utu:Responsive Layout={StaticResource HeaderBreakpoints}, Narrow=Left, Normal=Center}"
              Margin="{utu:Responsive Layout={StaticResource HeaderBreakpoints}, Narrow='24,0,0,60', Normal='0,0,0,16'}"
              Visibility="{x:Bind ViewModel.State.StageFull, Mode=OneWay}">
        <ItemsControl ItemsSource="{x:Bind ViewModel.Layers, Mode=OneWay}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:LayerItem">
              <Button Style="{StaticResource BareButton}" Command="{x:Bind Command}" CommandParameter="{x:Bind Id}"
                      ToolTipService.ToolTip="{x:Bind Label}">
                <!-- xaml-lint: allow card - the current-segment highlight of a segmented control, not a card -->
                <Border Background="{x:Bind Background}" CornerRadius="6" Padding="11,7">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <shapes:Path Data="{x:Bind Icon}" Stroke="{x:Bind Foreground}" StrokeThickness="1.8"
                                 Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind Label}" FontFamily="{StaticResource BodyMediumFont}" FontSize="13"
                               Foreground="{x:Bind Foreground}" />
                  </StackPanel>
                </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <Button Style="{StaticResource GhostButton}" Command="{x:Bind ViewModel.State.ToggleStageCommand}"
              Content="{x:Bind ViewModel.State.StageToggleLabel, Mode=OneWay}"
              Visibility="{x:Bind ViewModel.State.ShowStageToggle, Mode=OneWay}"
              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
              Background="{StaticResource SurfaceInvariantBrush}" Padding="11,7" CornerRadius="{StaticResource RadiusControl}" />
    </Grid>

    <!-- ══ SECTION ═════════════════════════════════════════════════════ -->
    <ScrollViewer x:Name="SectionScroll" Grid.Row="2" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto"
                  VerticalScrollBarVisibility="Auto" ZoomMode="Disabled">
      <!-- Section region: one pane per route in App.RegisterRoutes. Each pane is x:Load'ed, so
           startup pays for the section you open on; the rest are realized one per idle turn after
           load (MainPage.WarmSections), and a jump to one not yet built realizes it on the spot
           (the navigator finds panes by name). x:Name and Region.Name are both the route id. -->
      <Grid x:Name="Sections" uen:Region.Attached="True" uen:Region.Navigator="Visibility">
        <local:OverviewView x:Name="overview" x:Load="False" uen:Region.Name="overview" Visibility="Collapsed"
                            DataContext="{x:Bind ViewModel.Overview, Mode=OneWay}" />
        <local:BerthsView x:Name="berths" x:Load="False" uen:Region.Name="berths" Visibility="Collapsed"
                          DataContext="{x:Bind ViewModel.Berths, Mode=OneWay}" />
        <local:CargoView x:Name="cargo" x:Load="False" uen:Region.Name="cargo" Visibility="Collapsed"
                         DataContext="{x:Bind ViewModel.Cargo, Mode=OneWay}" />
        <local:FleetView x:Name="fleet" x:Load="False" uen:Region.Name="fleet" Visibility="Collapsed"
                         DataContext="{x:Bind ViewModel.Fleet, Mode=OneWay}" />
        <local:SecurityView x:Name="security" x:Load="False" uen:Region.Name="security" Visibility="Collapsed"
                            DataContext="{x:Bind ViewModel.Security, Mode=OneWay}" />
      </Grid>
    </ScrollViewer>

  </Grid>

  <!-- ══ CONTAINER INSPECTION ════════════════════════════════════════ -->
  <local:ScannerOverlay DataContext="{x:Bind ViewModel.Scanner, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.State.ScannerOpen, Mode=OneWay, FallbackValue=Collapsed}" />
  </Grid>
</Page>
