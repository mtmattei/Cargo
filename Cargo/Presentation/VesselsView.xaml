<UserControl x:Class="Cargo.Presentation.VesselsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Cargo.Presentation"
             xmlns:controls="using:Cargo.Controls"
             xmlns:utu="using:Uno.Toolkit.UI"
             xmlns:shapes="using:Microsoft.UI.Xaml.Shapes">

  <Grid Style="{StaticResource SectionFrame}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Spacing="4">
      <TextBlock Text="{x:Bind ViewModel.VesselName, Mode=OneWay}" Style="{StaticResource SectionHeadText}" />
      <TextBlock Text="{x:Bind ViewModel.Eyebrow, Mode=OneWay}" Style="{StaticResource CaptionText}" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240" />
        <ColumnDefinition Width="*" MinWidth="560" />
        <ColumnDefinition Width="290" />
      </Grid.ColumnDefinitions>

      <!-- ── Vessels in port ────────────────────────────────────── -->
      <StackPanel Spacing="10">
        <ItemsControl ItemsSource="{x:Bind ViewModel.Vessels, Mode=OneWay}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:VesselRow">
              <Button Style="{StaticResource RowButton}" Command="{x:Bind Select}" CommandParameter="{x:Bind Id}">
                <utu:CardContentControl Style="{StaticResource OutlinedPanel}" BorderBrush="{x:Bind Border}" BorderThickness="1.5" Padding="14">
                  <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="72" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="5">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="7" Height="7" Fill="{x:Bind Tone}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind Name}" FontFamily="{StaticResource BodyStrongFont}" FontSize="13" />
                      </StackPanel>
                      <TextBlock Text="{x:Bind Line1}" Style="{StaticResource CaptionText}" Margin="15,0,0,0"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{x:Bind Line2}" Style="{StaticResource CaptionText}" Margin="15,0,0,0"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Image Grid.Column="1" Source="{x:Bind Silhouette}" Width="84" Height="30"
                           Stretch="Uniform" VerticalAlignment="Center" />
                  </Grid>
                </utu:CardContentControl>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Style="{StaticResource GhostButton}" Command="{x:Bind ViewModel.State.OpenDockingCommand}"
                Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="16,12"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
          <Grid>
            <TextBlock Text="View all in Docking" FontFamily="{StaticResource BodyMediumFont}" FontSize="12.5" />
            <TextBlock Text="↗" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
          </Grid>
        </Button>
      </StackPanel>

      <!-- ── Profile and operations ─────────────────────────────── -->
      <StackPanel Grid.Column="1" Spacing="16">
        <utu:CardContentControl Style="{StaticResource PanelCard}" Padding="22,18,22,14">
          <Grid>
            <StackPanel Spacing="4">
              <Grid>
                <StackPanel Spacing="4">
                  <TextBlock Text="Side profile" Style="{StaticResource CardTitleText}" />
                  <TextBlock Text="{x:Bind ViewModel.ProfileHint, Mode=OneWay}" Style="{StaticResource CaptionText}" FontSize="12" />
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.BayLabel, Mode=OneWay}" Style="{StaticResource BodyStrongText}" FontSize="12"
                           Foreground="{StaticResource TealBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" />
              </Grid>
              <ContentControl x:Name="ProfileHost" HorizontalContentAlignment="Stretch" Margin="0,4,0,0" />
              <ItemsControl ItemsSource="{x:Bind ViewModel.CargoLegend, Mode=OneWay}" Margin="0,10,0,2">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="18" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:LegendItem">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{x:Bind Swatch}"
                                 VerticalAlignment="Center" />
                      <TextBlock Text="{x:Bind Label}" Style="{StaticResource CaptionText}" FontSize="12" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- Key figures, floated over the empty water at the bow -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.MiniCards, Mode=OneWay}" Width="250"
                          HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,52,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><controls:TwoColumnPanel ColumnSpacing="8" RowSpacing="8" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:MiniCard">
                  <utu:CardContentControl Style="{StaticResource OutlinedPanel}" Background="{StaticResource PaperBrush}" Padding="12,10,12,9">
                    <StackPanel Spacing="3">
                      <!-- xaml-lint: allow card - icon disc -->
                      <Border Width="22" Height="22" CornerRadius="11" BorderThickness="1" Margin="0,0,0,5"
                              BorderBrush="{StaticResource HairlineStrongBrush}">
                        <shapes:Path Data="{x:Bind Icon}" Stroke="{StaticResource InkBrush}"
                                   StrokeThickness="2" Width="11" Height="11" Stretch="Uniform" />
                      </Border>
                      <TextBlock Text="{x:Bind Key}" Style="{StaticResource MicroText}" />
                      <TextBlock Text="{x:Bind Value, Mode=OneWay}" FontFamily="{StaticResource DisplayFont}" FontSize="15"
                                 Foreground="{x:Bind Tone}" />
                      <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource MicroText}" FontSize="10.5" />
                    </StackPanel>
                  </utu:CardContentControl>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </utu:CardContentControl>

        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <utu:CardContentControl Style="{StaticResource PanelCard}">
            <StackPanel Spacing="10">
              <Grid>
                <TextBlock Text="Cargo operations" Style="{StaticResource CardTitleText}" />
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Ellipse Width="6" Height="6" Fill="{StaticResource AlertBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{x:Bind ViewModel.MovesLabel, Mode=OneWay}" Style="{StaticResource CaptionText}" />
                </StackPanel>
              </Grid>
              <!-- xaml-lint: allow card - clips the scene -->
              <Border CornerRadius="12" Background="{StaticResource SurfaceBrush}">
                <controls:CargoOpsScene Vessel="{x:Bind ViewModel.Vessel, Mode=OneWay}" />
              </Border>
              <Grid ColumnSpacing="14" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="8">
                  <Grid>
                    <TextBlock Text="Unloading" Style="{StaticResource BodyStrongText}" />
                    <TextBlock Text="{x:Bind ViewModel.UnloadLive, Mode=OneWay}" FontFamily="{StaticResource MonoMediumFont}"
                               FontSize="12.5" Foreground="{StaticResource SeaGreenBrush}" HorizontalAlignment="Right" />
                  </Grid>
                  <controls:TickBar Height="14" LitToken="SeaGreenBrush" Percent="{x:Bind ViewModel.UnloadPercent, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8">
                  <Grid>
                    <TextBlock Text="Loading" Style="{StaticResource BodyStrongText}" />
                    <TextBlock Text="{x:Bind ViewModel.LoadLive, Mode=OneWay}" FontFamily="{StaticResource MonoMediumFont}"
                               FontSize="12.5" Foreground="{StaticResource TealBrush}" HorizontalAlignment="Right" />
                  </Grid>
                  <controls:TickBar Height="14" LitToken="TealBrush" Percent="{x:Bind ViewModel.LoadPercent, Mode=OneWay}" />
                </StackPanel>
              </Grid>
              <TextBlock Text="{x:Bind ViewModel.OpsNote, Mode=OneWay}" Style="{StaticResource CaptionText}" FontSize="12"
                         TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
          </utu:CardContentControl>

          <utu:CardContentControl Style="{StaticResource PanelCard}" Grid.Column="1">
            <StackPanel Spacing="14">
              <TextBlock Text="Cargo composition" Style="{StaticResource PanelTitleText}" />
              <controls:CompositionBar Height="14" Slices="{x:Bind ViewModel.CompositionSlices, Mode=OneWay}" />
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Composition, Mode=OneWay}" VerticalAlignment="Center">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="7" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:CompositionSlice">
                      <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="{x:Bind Fill}"
                                     VerticalAlignment="Center" />
                          <TextBlock Text="{x:Bind Label}" Style="{StaticResource BodyText}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind Count}" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Right" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid Grid.Column="1" Width="104" Height="104">
                  <controls:DonutChart Radius="38" Thickness="14" Slices="{x:Bind ViewModel.CompositionSlices, Mode=OneWay}" />
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.TeuLabel, Mode=OneWay}" FontFamily="{StaticResource BodyStrongFont}"
                               FontSize="15" HorizontalAlignment="Center" />
                    <TextBlock Text="TEU" Style="{StaticResource MicroText}" FontSize="10" HorizontalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </Grid>
            </StackPanel>
          </utu:CardContentControl>
        </Grid>
      </StackPanel>

      <!-- ── Voyage ─────────────────────────────────────────────── -->
      <utu:CardContentControl Style="{StaticResource PanelCard}" Grid.Column="2" Padding="22,20">
        <StackPanel Spacing="16">
          <Grid>
            <TextBlock Text="Voyage" Style="{StaticResource PanelTitleText}" FontSize="15" VerticalAlignment="Center" />
            <!-- xaml-lint: allow card - status pill; half-height radius (99 draws an oval on Skia) -->
            <Border Background="{x:Bind ViewModel.SecurityBackground, Mode=OneWay}" CornerRadius="11" Padding="10,4"
                    HorizontalAlignment="Right">
              <TextBlock Text="{x:Bind ViewModel.Security, Mode=OneWay}" FontFamily="{StaticResource BodyMediumFont}"
                         FontSize="11" Foreground="{x:Bind ViewModel.SecurityForeground, Mode=OneWay}" />
            </Border>
          </Grid>
          <TextBlock Text="{x:Bind ViewModel.Voyage, Mode=OneWay}" Style="{StaticResource BodyText}" FontSize="13.5"
                     TextWrapping="Wrap" LineHeight="20" />

          <ItemsControl ItemsSource="{x:Bind ViewModel.Facts, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><controls:TwoColumnPanel ColumnSpacing="14" RowSpacing="14" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:Fact">
                <StackPanel Spacing="3">
                  <TextBlock Text="{x:Bind Key}" Style="{StaticResource MicroText}" FontSize="11.5" />
                  <TextBlock Text="{x:Bind Value}" Style="{StaticResource BodyStrongText}" FontSize="13.5" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Height="1" Background="{StaticResource HairlineBrush}" />
          <StackPanel Spacing="10">
            <TextBlock Text="Security clearance" Style="{StaticResource BodyStrongText}" FontSize="13.5" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Checks, Mode=OneWay}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:CheckRow">
                  <Grid ColumnSpacing="9">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="12" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Mark}" FontFamily="{StaticResource BodyStrongFont}" FontSize="12.5"
                               Foreground="{x:Bind Tone}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Label}" Style="{StaticResource BodyText}" />
                    <TextBlock Grid.Column="2" Text="{x:Bind Time}" FontFamily="{StaticResource MonoFont}"
                               FontSize="11.5" Foreground="{StaticResource TextFaintBrush}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <Button Style="{StaticResource GhostButton}" Command="{x:Bind ViewModel.State.OpenDockingCommand}"
                  Content="Open in Docking →" HorizontalAlignment="Stretch" Margin="0,4,0,0" />
        </StackPanel>
      </utu:CardContentControl>
    </Grid>

    <!-- ── Bay detail ───────────────────────────────────────────── -->
    <utu:CardContentControl Style="{StaticResource PanelCard}" Grid.Row="2" Padding="22,18">
      <StackPanel Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="14">
          <TextBlock Text="{x:Bind ViewModel.BayHeading, Mode=OneWay}" FontFamily="{StaticResource BodyStrongFont}" FontSize="17" />
          <TextBlock Text="{x:Bind ViewModel.BayTotal, Mode=OneWay}" Style="{StaticResource BodyText}"
                     Foreground="{StaticResource TealBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2" />
          <TextBlock Text="{x:Bind ViewModel.BayRemaining, Mode=OneWay}" Style="{StaticResource CaptionText}" FontSize="12.5"
                     VerticalAlignment="Bottom" Margin="0,0,0,2" />
        </StackPanel>

        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1.1*" />
          </Grid.ColumnDefinitions>

          <!-- xaml-lint: allow card - clips the scene -->
          <Border CornerRadius="12" Background="{StaticResource SurfaceBrush}">
            <controls:BayScene Bay="{x:Bind ViewModel.Bay, Mode=OneWay}" />
          </Border>

          <StackPanel Grid.Column="1" Spacing="14" Padding="4,6">
            <TextBlock Text="{x:Bind ViewModel.BayOpsHeading, Mode=OneWay}" Style="{StaticResource BodyStrongText}" FontSize="13.5" />
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Image Source="ms-appx:///Assets/Sprites/crane-rtg-1.png" Width="56" Height="70"
                     Stretch="Uniform" VerticalAlignment="Top" />
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Unloaded" Style="{StaticResource CaptionText}" Foreground="{StaticResource SeaGreenBrush}" />
                <TextBlock Text="{x:Bind ViewModel.BayUnloaded, Mode=OneWay}" FontFamily="{StaticResource BodyStrongFont}"
                           FontSize="22" Foreground="{StaticResource SeaGreenBrush}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="Remaining" Style="{StaticResource CaptionText}" />
                <TextBlock Text="{x:Bind ViewModel.BayLeft, Mode=OneWay}" FontFamily="{StaticResource BodyStrongFont}"
                           FontSize="22" Foreground="{StaticResource TealBrush}" />
              </StackPanel>
            </Grid>
            <StackPanel Spacing="2">
              <TextBlock Text="Next move" Style="{StaticResource CaptionText}" FontSize="12" />
              <TextBlock Text="{x:Bind ViewModel.BayNextMove, Mode=OneWay}" Style="{StaticResource BodyStrongText}" FontSize="14" />
              <TextBlock Text="{x:Bind ViewModel.BayNextEta, Mode=OneWay}" Style="{StaticResource CaptionText}" FontSize="12" />
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Column="2" Spacing="12" Padding="4,6">
            <TextBlock Text="{x:Bind ViewModel.BayCompositionHeading, Mode=OneWay}" Style="{StaticResource BodyStrongText}" FontSize="13.5" />
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <controls:DonutChart Width="92" Height="92" VerticalAlignment="Top" Radius="36" Thickness="16" Slices="{x:Bind ViewModel.BaySlices, Mode=OneWay}" />
              <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.BayComposition, Mode=OneWay}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="7" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:CompositionSlice">
                    <Grid ColumnSpacing="8">
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="{x:Bind Fill}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind Label}" Style="{StaticResource BodyText}" FontSize="12" />
                      </StackPanel>
                      <TextBlock Text="{x:Bind Count}" Style="{StaticResource CaptionText}" FontSize="12"
                                 HorizontalAlignment="Right" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </StackPanel>

          <Grid Grid.Column="3" ColumnSpacing="14" Padding="18,6,4,6"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1,0,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="{x:Bind ViewModel.BayContainerImage, Mode=OneWay}" Width="110" Height="80" Stretch="Uniform"
                   VerticalAlignment="Top" Margin="0,6,0,0" />
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="{x:Bind ViewModel.BayContainerId, Mode=OneWay}" FontFamily="{StaticResource MonoMediumFont}" FontSize="14" />
              <TextBlock Text="{x:Bind ViewModel.BayContainerType, Mode=OneWay}" Style="{StaticResource CaptionText}" FontSize="12"
                         TextWrapping="Wrap" />
              <Grid ColumnSpacing="14" RowSpacing="6" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Weight" Style="{StaticResource MicroText}" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.BayContainerWeight, Mode=OneWay}"
                           Style="{StaticResource BodyStrongText}" FontSize="12" HorizontalAlignment="Right" />
                <TextBlock Grid.Row="1" Text="Status" Style="{StaticResource MicroText}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.BayContainerStatus, Mode=OneWay}"
                           Style="{StaticResource BodyStrongText}" FontSize="12" HorizontalAlignment="Right"
                           Foreground="{StaticResource TealBrush}" />
              </Grid>
            </StackPanel>
          </Grid>
        </Grid>
      </StackPanel>
    </utu:CardContentControl>
  </Grid>
</UserControl>
