<Page x:Class="Cargo.Presentation.SecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Cargo.Presentation"
             xmlns:controls="using:Cargo.Controls"
             xmlns:utu="using:Uno.Toolkit.UI"
             xmlns:uen="using:Uno.Extensions.Navigation.UI">

  <Grid Padding="40,24,40,48" MinWidth="1100" MaxWidth="1520" RowSpacing="20" uen:Region.Attached="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="12">
        <TextBlock Text="SECURITY · ISPS LEVEL 1 · 1 HOLD ACTIVE" Style="{StaticResource EyebrowText}" />
        <TextBlock Text="{x:Bind ViewModel.State.SecurityTitle, Mode=OneWay}" Style="{StaticResource PageTitleText}" />
      </StackPanel>
      <!-- xaml-lint: allow card - segmented tab strip; the Simple theme ships no segmented TabBar style -->
      <Border Grid.Column="1" Background="{StaticResource SurfaceSunkAltInvariantBrush}" CornerRadius="12" Padding="4"
              VerticalAlignment="Bottom">
        <ItemsControl ItemsSource="{x:Bind ViewModel.Tabs, Mode=OneWay}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:PageTab">
              <Button Style="{StaticResource BareButton}" uen:Navigation.Request="{x:Bind Route}">
                <!-- xaml-lint: allow card - the current-tab highlight inside the segmented strip -->
                <Border Background="{x:Bind Background}" CornerRadius="9" Padding="14,7">
                  <TextBlock Text="{x:Bind Label}" FontFamily="{StaticResource BodyMediumFont}" FontSize="12.5"
                             Foreground="{x:Bind Foreground}" />
                </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </Grid>

    <!-- Tabs: nested routes under "security" (App.RegisterRoutes), shown in this Visibility region -->
    <Grid Grid.Row="1" uen:Region.Attached="True" uen:Region.Navigator="Visibility">

    <!-- ══ ZONES ═════════════════════════════════════════════════════ -->
    <Grid uen:Region.Name="zones" ColumnSpacing="18" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="620" />
        <ColumnDefinition Width="380" />
      </Grid.ColumnDefinitions>

      <StackPanel Spacing="18">
        <utu:CardContentControl Style="{StaticResource OutlinedPanel}" Padding="0"
                                CornerRadius="{StaticResource RadiusCard}" Background="{StaticResource LandInvariantBrush}">
          <controls:SecurityZoneMap />
        </utu:CardContentControl>

        <utu:CardContentControl Style="{StaticResource PanelCard}" Padding="22,20,22,18">
          <StackPanel Spacing="12">
            <Grid>
              <TextBlock Text="Security timeline" Style="{StaticResource CardTitleText}" />
              <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Ellipse Width="7" Height="7" Fill="{StaticResource AccentInvariantBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="clearance" Style="{StaticResource CaptionText}" FontSize="12" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Ellipse Width="7" Height="7" Fill="{StaticResource OrangeInvariantBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="hold" Style="{StaticResource CaptionText}" FontSize="12" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Ellipse Width="7" Height="7" Fill="{StaticResource RestrictedInvariantBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="incident" Style="{StaticResource CaptionText}" FontSize="12" />
                </StackPanel>
              </StackPanel>
            </Grid>
            <controls:SecurityTimeline />
          </StackPanel>
        </utu:CardContentControl>
      </StackPanel>

      <StackPanel Grid.Column="1" Spacing="14">
        <utu:CardContentControl Style="{StaticResource PanelCard}" Padding="20,18">
          <StackPanel Spacing="8">
            <Grid>
              <TextBlock Text="MSCU 482193 7" FontFamily="{StaticResource MonoMediumFont}" FontSize="14" />
              <!-- xaml-lint: allow card - a status pill, not a card; half-height radius (99 draws an oval on Skia) -->
              <Border Background="{StaticResource SurfaceSunkInvariantBrush}" CornerRadius="10" Padding="8,3"
                      HorizontalAlignment="Right">
                <TextBlock Text="Cleared" FontFamily="{StaticResource BodyMediumFont}" FontSize="11"
                           Foreground="{StaticResource AccentInvariantBrush}" />
              </Border>
            </Grid>
            <ItemsControl ItemsSource="{x:Bind ViewModel.ClearedChecks, Mode=OneWay}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="5" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:CheckRow">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Bind Mark}" FontFamily="{StaticResource BodyStrongFont}" FontSize="12.5"
                               Foreground="{x:Bind Tone}" />
                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </utu:CardContentControl>

        <utu:CardContentControl Style="{StaticResource PanelCard}" Padding="20,18" BorderBrush="{StaticResource OrangeInvariantBrush}">
          <StackPanel Spacing="8">
            <Grid>
              <TextBlock Text="CMAU 918204 4" FontFamily="{StaticResource MonoMediumFont}" FontSize="14" />
              <!-- xaml-lint: allow card - a status pill, not a card; half-height radius (99 draws an oval on Skia) -->
              <Border Background="{StaticResource SurfaceSunkInvariantBrush}" CornerRadius="10" Padding="8,3"
                      HorizontalAlignment="Right">
                <TextBlock Text="Hold" FontFamily="{StaticResource BodyMediumFont}" FontSize="11"
                           Foreground="{StaticResource OrangeInkInvariantBrush}" />
              </Border>
            </Grid>
            <ItemsControl ItemsSource="{x:Bind ViewModel.HeldChecks, Mode=OneWay}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="5" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:CheckRow">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Bind Mark}" FontFamily="{StaticResource BodyStrongFont}" FontSize="12.5"
                               Foreground="{x:Bind Tone}" />
                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Style="{StaticResource PrimaryButton}" Content="Open inspection →" Margin="0,4,0,0"
                    Command="{x:Bind ViewModel.State.OpenInspectionCommand, Mode=OneWay}" HorizontalAlignment="Left" Padding="12,8" />
          </StackPanel>
        </utu:CardContentControl>

        <utu:CardContentControl Style="{StaticResource PanelCard}" Padding="20,18">
          <StackPanel Spacing="12">
            <TextBlock Text="Records today" Style="{StaticResource PanelTitleText}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Records, Mode=OneWay}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:RecordRow">
                  <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="8" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="8" Height="8" Fill="{x:Bind Tone}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Label}" Style="{StaticResource BodyText}" />
                    <TextBlock Grid.Column="2" Text="{x:Bind Count}" FontFamily="{StaticResource MonoMediumFont}"
                               FontSize="12" Foreground="{StaticResource TextMutedInvariantBrush}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </utu:CardContentControl>
      </StackPanel>
    </Grid>

    <!-- ══ ACCESS CONTROL ════════════════════════════════════════════ -->
    <Grid uen:Region.Name="access" ColumnSpacing="18" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Spacing="14">
        <TextBlock Text="Personnel" Style="{StaticResource PanelTitleText}" Foreground="{StaticResource TextMutedInvariantBrush}" />
        <ItemsControl ItemsSource="{x:Bind ViewModel.People, Mode=OneWay}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><controls:TileGridPanel MinTileWidth="230" Gap="12" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:PersonCard">
              <Button Style="{StaticResource RowButton}" Command="{x:Bind Select}" CommandParameter="{x:Bind Index}">
                <utu:CardContentControl Style="{StaticResource OutlinedPanel}" BorderBrush="{x:Bind Border}" Padding="14">
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="46" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- xaml-lint: allow card - avatar swatch -->
                    <Border Width="46" Height="46" CornerRadius="12" Background="{x:Bind Avatar}">
                      <TextBlock Text="{x:Bind Initials}" FontFamily="{StaticResource BodyStrongFont}" FontSize="14"
                                 Foreground="{StaticResource SurfaceInvariantBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Text="{x:Bind Name}" FontFamily="{StaticResource BodyStrongFont}" FontSize="13.5" />
                      <TextBlock Text="{x:Bind Role}" Style="{StaticResource CaptionText}" FontSize="12" />
                      <TextBlock Text="{x:Bind Credential}" FontFamily="{StaticResource MonoMediumFont}" FontSize="11"
                                 Foreground="{StaticResource AccentInvariantBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                  </Grid>
                </utu:CardContentControl>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <utu:CardContentControl Style="{StaticResource PanelCard}" Padding="20,18">
          <StackPanel Spacing="10">
            <Grid>
              <TextBlock Text="{x:Bind ViewModel.ZoneHeading, Mode=OneWay}" Style="{StaticResource CardTitleText}" />
              <TextBlock Text="{x:Bind ViewModel.ZoneCount, Mode=OneWay}" Style="{StaticResource CaptionText}" FontSize="12"
                         HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <controls:AccessZoneMap Allowed="{x:Bind ViewModel.AllowedZones, Mode=OneWay}" />
          </StackPanel>
        </utu:CardContentControl>
      </StackPanel>

      <StackPanel Grid.Column="1" Spacing="14">
        <TextBlock Text="Vehicles at gates" Style="{StaticResource PanelTitleText}"
                   Foreground="{StaticResource TextMutedInvariantBrush}" />
        <ItemsControl ItemsSource="{x:Bind ViewModel.Vehicles, Mode=OneWay}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:VehicleCard">
              <utu:CardContentControl Style="{StaticResource OutlinedPanel}">
                <Grid ColumnSpacing="14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <controls:YardTruck Tint="{x:Bind Tint}" Width="92" Height="38" VerticalAlignment="Center" />
                  <ItemsControl Grid.Column="1" ItemsSource="{x:Bind Facts}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><controls:TileGridPanel MinTileWidth="150" Gap="10" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="local:Fact">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{x:Bind Key}" Style="{StaticResource MicroText}" FontSize="10.5" />
                          <TextBlock Text="{x:Bind Value}" Style="{StaticResource BodyStrongText}" FontSize="12.5" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </utu:CardContentControl>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Grid>

    <!-- ══ INSPECTION ════════════════════════════════════════════════ -->
    <Grid uen:Region.Name="inspection" ColumnSpacing="18" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="620" />
        <ColumnDefinition Width="340" />
      </Grid.ColumnDefinitions>

      <utu:CardContentControl Style="{StaticResource PanelCard}" Padding="26,22,26,18">
        <StackPanel Spacing="6">
          <Grid>
            <TextBlock Text="CMAU 918204 4" FontFamily="{StaticResource MonoMediumFont}" FontSize="18" />
            <TextBlock Text="40 FT HC · CMA CGM · Westhaven → Le Havre · Lane 2"
                       Style="{StaticResource CaptionText}" FontSize="12.5"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
          <controls:InspectionDiagram />
        </StackPanel>
      </utu:CardContentControl>

      <StackPanel Grid.Column="1" Spacing="14">
        <utu:CardContentControl Style="{StaticResource PanelCard}" Padding="20,18" BorderBrush="{StaticResource OrangeInvariantBrush}">
          <StackPanel Spacing="6">
            <TextBlock Text="⚠ Weight variance" FontFamily="{StaticResource BodyStrongFont}" FontSize="13.5"
                       Foreground="{StaticResource OrangeInkInvariantBrush}" />
            <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" LineHeight="19"
                       Text="Declared 24,120 kg · measured 25,920 kg (+1.8 t, +7.5%). Exceeds the 5% tolerance — physical inspection scheduled before customs release." />
          </StackPanel>
        </utu:CardContentControl>

        <utu:CardContentControl Style="{StaticResource PanelCard}" Padding="20,18">
          <StackPanel Spacing="12">
            <TextBlock Text="Inspection log" Style="{StaticResource PanelTitleText}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.InspectionLog, Mode=OneWay}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:CheckRow">
                  <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="44" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Time}" FontFamily="{StaticResource MonoMediumFont}" FontSize="11.5"
                               Foreground="{StaticResource TextFaintInvariantBrush}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7">
                      <TextBlock Text="{x:Bind Mark}" FontFamily="{StaticResource BodyStrongFont}" FontSize="12.5"
                                 Foreground="{x:Bind Tone}" />
                      <TextBlock Text="{x:Bind Label}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                 LineHeight="18" MaxWidth="220" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </utu:CardContentControl>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Style="{StaticResource PrimaryButton}" Content="Assign inspector" Width="160" />
          <Button Style="{StaticResource GhostButton}" Content="Request re-weigh" Width="160" />
        </StackPanel>
      </StackPanel>
    </Grid>
    </Grid>
  </Grid>
</Page>
