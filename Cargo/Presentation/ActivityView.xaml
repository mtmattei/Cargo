<UserControl x:Class="Cargo.Presentation.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Cargo.Presentation"
             xmlns:controls="using:Cargo.Controls"
             xmlns:shapes="using:Microsoft.UI.Xaml.Shapes">

  <Grid Padding="44,34,44,48" MaxWidth="1160" HorizontalAlignment="Center" RowSpacing="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Spacing="12">
      <TextBlock Text="{x:Bind Eyebrow}" Style="{StaticResource EyebrowText}" />
      <TextBlock Text="What happened today" Style="{StaticResource PageTitleText}" />
    </StackPanel>

    <controls:Card Grid.Row="1" Padding="22,20,22,14">
      <StackPanel Spacing="22">
        <Grid>
          <TextBlock Text="Container throughput" Style="{StaticResource CardTitleText}" />
          <TextBlock Text="moves per hour · 2,146 so far" Style="{StaticResource CaptionText}" FontSize="12"
                     HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <ContentControl x:Name="ThroughputHost" HorizontalContentAlignment="Stretch" />
      </StackPanel>
    </controls:Card>

    <ItemsControl Grid.Row="2" ItemsSource="{x:Bind Feed}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="local:FeedEntry">
          <Grid ColumnSpacing="12" Padding="0,0,0,18">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="56" />
              <ColumnDefinition Width="28" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind Time}" FontFamily="{StaticResource MonoMediumFont}" FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0" />
            <Grid Grid.Column="1">
              <Rectangle Width="1" Fill="{StaticResource HairlineStrongBrush}" HorizontalAlignment="Center"
                         VerticalAlignment="Stretch" Margin="0,34,0,-18" MinHeight="14" />
              <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource SurfaceBrush}"
                      BorderThickness="1.5" BorderBrush="{x:Bind Tone}" VerticalAlignment="Top">
                <shapes:Path Data="{x:Bind Icon}" Stroke="{x:Bind Tone}" StrokeThickness="1.8"
                             Width="14" Height="14" Stretch="Uniform" />
              </Border>
            </Grid>
            <StackPanel Grid.Column="2" Spacing="2" Margin="0,5,0,0">
              <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongText}" FontSize="13.5" />
              <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionText}" FontSize="12.5"
                         TextWrapping="Wrap" LineHeight="18" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</UserControl>
