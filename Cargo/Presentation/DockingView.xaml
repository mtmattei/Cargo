<UserControl x:Class="Cargo.Presentation.DockingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Cargo.Presentation"
             xmlns:controls="using:Cargo.Controls"
             xmlns:utu="using:Uno.Toolkit.UI"
             xmlns:shapes="using:Microsoft.UI.Xaml.Shapes">

  <Grid Style="{StaticResource SectionFrame}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ── Masthead ─────────────────────────────────────────────── -->
    <Grid ColumnSpacing="20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="4">
        <TextBlock Text="Berth plan" Style="{StaticResource SectionHeadText}" />
        <TextBlock Text="Next 36 hours · drag an arriving vessel onto a berth" Style="{StaticResource CaptionText}" />
      </StackPanel>
      <ItemsControl Grid.Column="1" ItemsSource="{x:Bind Legend}" VerticalAlignment="Bottom">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="14" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:LegendItem">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Rectangle Width="10" Height="10" RadiusX="3" RadiusY="3" Fill="{x:Bind Swatch}" VerticalAlignment="Center" />
              <TextBlock Text="{x:Bind Label}" Style="{StaticResource CaptionText}" FontSize="12" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>

    <!-- ── Scrubber ─────────────────────────────────────────────── -->
    <utu:CardContentControl Style="{StaticResource PanelCard}" Grid.Row="1" Padding="18,12">
      <Grid ColumnSpacing="18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button x:Name="NowButton" Style="{StaticResource GhostButton}" Content="Now" Padding="12,7"
                  CornerRadius="8" FontSize="12" Click="OnNowClick" />
          <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center">
            <Run Text="Viewing " /><Run Text="{x:Bind PlanLabel, Mode=OneWay}"
                                        FontFamily="{StaticResource MonoMediumFont}"
                                        Foreground="{StaticResource InkBrush}" />
          </TextBlock>
        </StackPanel>

        <Grid Grid.Column="1" VerticalAlignment="Center">
          <Slider x:Name="Scrubber" Style="{StaticResource ScrubSlider}" Minimum="0" Maximum="36"
                  StepFrequency="0.25" ValueChanged="OnScrubbed" Margin="0,0,0,14" />
          <Grid VerticalAlignment="Bottom" IsHitTestVisible="False">
            <TextBlock Text="00:00" Style="{StaticResource MicroText}" FontSize="10" HorizontalAlignment="Left" />
            <TextBlock Text="12:00" Style="{StaticResource MicroText}" FontSize="10" HorizontalAlignment="Center" />
            <TextBlock Text="Thu 12:00" Style="{StaticResource MicroText}" FontSize="10" HorizontalAlignment="Right" />
          </Grid>
        </Grid>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="{x:Bind ConflictText, Mode=OneWay}" Style="{StaticResource CaptionText}" FontSize="12"
                     Foreground="{x:Bind ConflictTone, Mode=OneWay}" VerticalAlignment="Center"
                     MaxWidth="360" TextWrapping="Wrap" />
          <Button Style="{StaticResource PrimaryButton}" Click="OnOptimizeClick" CornerRadius="9" Padding="14,8">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <shapes:Path Data="M4 17l5-5 4 4 7-8M15 8h5v5" Stroke="{StaticResource PaperBrush}" StrokeThickness="2"
                           Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
              <TextBlock Text="Optimize traffic" FontFamily="{StaticResource BodyMediumFont}" FontSize="12.5"
                         Foreground="{StaticResource PaperBrush}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </utu:CardContentControl>

    <!-- ── Map, timeline and vessel panel ───────────────────────── -->
    <Grid Grid.Row="2" ColumnSpacing="18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="PanelColumn" Width="0" />
      </Grid.ColumnDefinitions>

      <StackPanel Spacing="18">
        <Grid>
          <Border CornerRadius="18" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                  Background="{StaticResource LandBrush}">
            <ContentControl x:Name="MapHost" HorizontalContentAlignment="Stretch" />
          </Border>
          <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16,14"
                  Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource HairlineBrush}"
                  BorderThickness="1" CornerRadius="10" Padding="12,8">
            <TextBlock Text="{x:Bind Hint, Mode=OneWay}" Style="{StaticResource CaptionText}" FontSize="12.5" />
          </Border>
        </Grid>

        <utu:CardContentControl Style="{StaticResource PanelCard}" Padding="22,20,22,18">
          <StackPanel Spacing="12">
            <Grid>
              <TextBlock Text="Berth timeline · 36 h" Style="{StaticResource CardTitleText}" />
              <TextBlock Text="Drag a vessel onto a berth · overlaps show in red"
                         Style="{StaticResource CaptionText}" FontSize="12" HorizontalAlignment="Right" />
            </Grid>
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid Grid.Column="1">
                <TextBlock Text="00:00" Style="{StaticResource MicroText}" FontSize="11" HorizontalAlignment="Left" />
                <TextBlock Text="12:00" Style="{StaticResource MicroText}" FontSize="11" HorizontalAlignment="Center" />
                <TextBlock Text="Thu 12:00" Style="{StaticResource MicroText}" FontSize="11" HorizontalAlignment="Right" />
              </Grid>
            </Grid>
            <ItemsControl ItemsSource="{x:Bind PlanRows, Mode=OneWay}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="7" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:PlanRow">
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="34" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Berth}" FontFamily="{StaticResource MonoMediumFont}" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Height="26" CornerRadius="7" Background="{StaticResource SurfaceSunkBrush}">
                      <controls:ProportionalPanel Segments="{x:Bind Segments}" NowFraction="{x:Bind NowFraction}" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </utu:CardContentControl>
      </StackPanel>

      <!-- ── Selected vessel ──────────────────────────────────────── -->
      <utu:CardContentControl Style="{StaticResource PanelCard}" x:Name="VesselPanel" Grid.Column="1" Padding="22,20" VerticalAlignment="Top"
                     Visibility="Collapsed">
        <StackPanel Spacing="14">
          <Grid>
            <StackPanel Spacing="3">
              <TextBlock Text="{x:Bind SelectedName, Mode=OneWay}" FontFamily="{StaticResource BodyStrongFont}"
                         FontSize="17" />
              <TextBlock Text="{x:Bind SelectedStatus, Mode=OneWay}" Style="{StaticResource CaptionText}" />
            </StackPanel>
            <Button Style="{StaticResource BareButton}" Content="×" Click="OnClearSelection"
                    HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="18"
                    Foreground="{StaticResource TextFaintBrush}" />
          </Grid>

          <Border CornerRadius="12" Background="{StaticResource SurfaceBrush}">
            <Grid Height="120">
              <Rectangle Fill="{StaticResource SeaFlatBrush}" Height="16" VerticalAlignment="Bottom" />
              <Image x:Name="SelectedProfile" Stretch="Uniform" Margin="18,6,18,10" />
            </Grid>
          </Border>

          <ItemsControl ItemsSource="{x:Bind SelectedFacts, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><controls:TwoColumnPanel ColumnSpacing="14" RowSpacing="12" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:Fact">
                <StackPanel Spacing="3">
                  <TextBlock Text="{x:Bind Key}" Style="{StaticResource MicroText}" />
                  <TextBlock Text="{x:Bind Value}" Style="{StaticResource BodyStrongText}" FontSize="14" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Height="1" Background="{StaticResource HairlineBrush}" />
          <TextBlock Text="{x:Bind SelectedNote, Mode=OneWay}" Style="{StaticResource CaptionText}" FontSize="12.5"
                     TextWrapping="Wrap" LineHeight="19" />

          <Button x:Name="ReleaseButton" Style="{StaticResource GhostButton}" Content="Release berth"
                  Click="OnReleaseClick" HorizontalAlignment="Stretch" Visibility="Collapsed" />
          <Button Style="{StaticResource PrimaryButton}" Content="Vessel profile →" Click="OnOpenProfileClick"
                  HorizontalAlignment="Stretch" />
        </StackPanel>
      </utu:CardContentControl>
    </Grid>
  </Grid>
</UserControl>
