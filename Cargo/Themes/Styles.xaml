<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utu="using:Uno.Toolkit.UI"
                    xmlns:controls="using:Cargo.Controls">

  <!-- ============================================================
       Type ramp
       Display type is Bricolage Grotesque; UI text Archivo; every
       figure that has to line up in a column is IBM Plex Mono.
       ============================================================ -->

  <Style x:Key="GreetingText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="44" />
    <Setter Property="LineHeight" Value="46" />
    <Setter Property="Foreground" Value="{StaticResource InkInvariantBrush}" />
  </Style>

  <Style x:Key="PageTitleText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="40" />
    <Setter Property="LineHeight" Value="42" />
    <Setter Property="Foreground" Value="{StaticResource InkInvariantBrush}" />
  </Style>

  <Style x:Key="EyebrowText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoMediumFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource TealInvariantBrush}" />
  </Style>

  <Style x:Key="CardTitleText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{StaticResource InkInvariantBrush}" />
  </Style>

  <Style x:Key="PanelTitleText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodyStrongFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource InkInvariantBrush}" />
  </Style>

  <Style x:Key="BodyText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{StaticResource InkInvariantBrush}" />
  </Style>

  <Style x:Key="BodyStrongText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
    <Setter Property="FontFamily" Value="{StaticResource BodyMediumFont}" />
  </Style>

  <Style x:Key="CaptionText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{StaticResource TextMutedInvariantBrush}" />
  </Style>

  <Style x:Key="MicroText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource TextFaintInvariantBrush}" />
  </Style>

  <Style x:Key="MetricText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="32" />
    <Setter Property="LineHeight" Value="32" />
    <Setter Property="Foreground" Value="{StaticResource InkInvariantBrush}" />
  </Style>

  <!-- ============================================================
       Cards — Toolkit CardContentControl, tuned by lightweight keys.
       PanelCard: surface, hairline edge, elevation (the section panels).
       OutlinedPanel: hairline only, for cards inside a panel or a row.
       Both stretch like the old Card did (the Toolkit base does not).
       These panels are static, so pointer-over keeps the resting fill:
       a hover tint on a panel reads as "this is clickable".
       ============================================================ -->
  <Style x:Key="PanelCard" TargetType="utu:CardContentControl" BasedOn="{StaticResource ElevatedCardContentControlStyle}">
    <Setter Property="Padding" Value="20,18" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="BorderThickness" Value="1" />
    <!-- The Simple template reads BorderBrush from the control; the ElevatedCardContentBorderBrush key had no effect -->
    <Setter Property="BorderBrush" Value="{StaticResource HairlineInvariantBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="utu:ResourceExtensions.Resources">
      <Setter.Value>
        <ResourceDictionary>
          <StaticResource x:Key="ElevatedCardContentBackground" ResourceKey="SurfaceInvariantBrush" />
          <StaticResource x:Key="CardContentBackgroundPointerOver" ResourceKey="SurfaceInvariantBrush" />
        </ResourceDictionary>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="OutlinedPanel" TargetType="utu:CardContentControl" BasedOn="{StaticResource OutlinedCardContentControlStyle}">
    <Setter Property="Padding" Value="16,14" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPanel}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineInvariantBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="utu:ResourceExtensions.Resources">
      <Setter.Value>
        <ResourceDictionary>
          <StaticResource x:Key="OutlinedCardContentBackground" ResourceKey="SurfaceInvariantBrush" />
          <StaticResource x:Key="CardContentBackgroundPointerOver" ResourceKey="SurfaceInvariantBrush" />
        </ResourceDictionary>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================
       Page template — every section page follows the Overview:
       one frame, a masthead over a hairline, then flat ruled sections.
       ============================================================ -->
  <Style x:Key="PageFrame" TargetType="Grid">
    <Setter Property="Padding" Value="{StaticResource PagePadding}" />
    <Setter Property="MinWidth" Value="1000" />
    <Setter Property="MaxWidth" Value="1520" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="RowSpacing" Value="28" />
  </Style>

  <Style x:Key="Masthead" TargetType="Grid">
    <Setter Property="BorderBrush" Value="{StaticResource HairlineStrongInvariantBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="0,0,0,18" />
    <Setter Property="ColumnSpacing" Value="24" />
  </Style>

  <!-- A part of a page (Berths hosts the plan and the vessel; Cargo the explorer and the yard) -->
  <Style x:Key="SectionFrame" TargetType="Grid">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="RowSpacing" Value="18" />
  </Style>

  <!-- Each part starts under a 2px ink rule, like the Overview's panels -->
  <Style x:Key="SectionRule" TargetType="Border">
    <Setter Property="BorderBrush" Value="{StaticResource InkInvariantBrush}" />
    <Setter Property="BorderThickness" Value="0,2,0,0" />
    <Setter Property="Padding" Value="0,18,0,0" />
  </Style>

  <Style x:Key="SectionHeadText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="Foreground" Value="{StaticResource InkInvariantBrush}" />
  </Style>

  <Style x:Key="PageSubtitleText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
    <Setter Property="FontSize" Value="14" />
  </Style>

  <!-- Masthead figures: a number and what it counts, baseline-aligned -->
  <!-- A headline figure: its label above, the number below, left-aligned on one edge -->
  <Style x:Key="FigureStack" TargetType="StackPanel">
    <Setter Property="Spacing" Value="4" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
  </Style>

  <Style x:Key="FigureLabelText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Status is a dot before an ink word; the dot is the only colour -->
  <Style x:Key="StatusDot" TargetType="Ellipse">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="MetricLabelText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Margin" Value="0,0,0,3" />
  </Style>

  <!-- Status as a dot and a word; the word takes the ink variant of the status colour -->
  <Style x:Key="StatusText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodyMediumFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Flat panel: the overview uses a 2px ink rule instead of a box -->
  <Style x:Key="RuledPanel" TargetType="Border">
    <Setter Property="BorderBrush" Value="{StaticResource InkInvariantBrush}" />
    <Setter Property="BorderThickness" Value="0,2,0,0" />
    <Setter Property="Padding" Value="0,18,22,14" />
  </Style>

  <!-- ============================================================
       Buttons
       ============================================================ -->

  <Style x:Key="PrimaryButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource InkInvariantBrush}" />
    <Setter Property="Foreground" Value="{StaticResource PaperInvariantBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource BodyMediumFont}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <Border.RenderTransform>
              <ScaleTransform x:Name="Squish" CenterX="0.5" CenterY="0.5" />
            </Border.RenderTransform>
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.88" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.78" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
    <Setter Property="Background" Value="{StaticResource SurfaceSunkInvariantBrush}" />
    <Setter Property="Foreground" Value="{StaticResource InkInvariantBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineStrongInvariantBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
    <Setter Property="Background" Value="{StaticResource TealBrightInvariantBrush}" />
    <Setter Property="Foreground" Value="{StaticResource InkDeepInvariantBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource BodyStrongFont}" />
  </Style>

  <!-- Transparent hit target: rows, cards, map furniture -->
  <Style x:Key="BareButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{StaticResource InkInvariantBrush}" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.82" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.7" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Selectable list rows keep their own chrome, so the bare template
       just needs to not paint anything over it -->
  <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource BareButton}">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <!-- ============================================================
       Harbour stage HUD — flat surface chips over the 3D scene
       ============================================================ -->
  <Style x:Key="HarbourHudPanel" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SurfaceInvariantBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource HairlineStrongInvariantBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    <Setter Property="Padding" Value="10,7" />
  </Style>

  <Style x:Key="HarbourSegment" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextMutedInvariantBrush}" />
    <Setter Property="Padding" Value="11,7" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <Style x:Key="HarbourSegmentCurrent" TargetType="Button" BasedOn="{StaticResource HarbourSegment}">
    <Setter Property="Background" Value="{StaticResource InkInvariantBrush}" />
    <Setter Property="Foreground" Value="{StaticResource PaperInvariantBrush}" />
  </Style>

  <Style x:Key="HarbourIconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
    <Setter Property="Background" Value="{StaticResource SurfaceInvariantBrush}" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="16" />
  </Style>

  <!-- Slider used by the docking timeline scrubber -->
  <Style x:Key="ScrubSlider" TargetType="Slider">
    <Setter Property="Foreground" Value="{StaticResource InkInvariantBrush}" />
    <Setter Property="Background" Value="{StaticResource SurfaceSunkAltInvariantBrush}" />
    <Setter Property="IsThumbToolTipEnabled" Value="False" />
  </Style>

</ResourceDictionary>
