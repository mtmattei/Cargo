<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shapes="using:Microsoft.UI.Xaml.Shapes">

  <!-- ============================================================
       Icons: 24-unit stroke geometry from the Overview design
       (docs/design/overview-timeline/EXTRACTION.md §2 Harbour), as Path
       styles: a Setter converts the path string to geometry, which a
       PathGeometry.Figures string does not on Uno. Place the Path in a
       24x24 Grid under a Viewbox (PathIcon clips instead of scaling,
       gotcha G65). Stroke colour comes from the consumer.
       ============================================================ -->

  <Style x:Key="StrokeIcon" TargetType="shapes:Path">
    <Setter Property="StrokeThickness" Value="1.6" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
  </Style>

  <!-- Design: camera dropdown chevron -->
  <Style x:Key="ChevronDownIcon" TargetType="shapes:Path" BasedOn="{StaticResource StrokeIcon}">
    <Setter Property="Data" Value="M7 10l5 5 5-5" />
  </Style>

  <!-- Design: zoom out / zoom in -->
  <Style x:Key="MinusIcon" TargetType="shapes:Path" BasedOn="{StaticResource StrokeIcon}">
    <Setter Property="Data" Value="M6 12h12" />
  </Style>
  <Style x:Key="PlusIcon" TargetType="shapes:Path" BasedOn="{StaticResource StrokeIcon}">
    <Setter Property="Data" Value="M6 12h12M12 6v12" />
  </Style>

  <!-- Design: harbour Expand / Collapse -->
  <Style x:Key="ExpandIcon" TargetType="shapes:Path" BasedOn="{StaticResource StrokeIcon}">
    <Setter Property="Data" Value="M14 4h6v6M10 20H4v-6M20 4l-6.5 6.5M4 20l6.5-6.5" />
  </Style>
  <Style x:Key="CollapseIcon" TargetType="shapes:Path" BasedOn="{StaticResource StrokeIcon}">
    <Setter Property="Data" Value="M20 10h-6V4M4 14h6v6M14 10l6.5-6.5M10 14l-6.5 6.5" />
  </Style>

  <!-- Harbour compass needle, 26-unit box: the north half filled alert, the south half hairline -->
  <Style x:Key="NorthNeedleIcon" TargetType="shapes:Path">
    <Setter Property="Data" Value="M13 3 L16.6 14 L13 12 L9.4 14 Z" />
  </Style>
  <Style x:Key="SouthNeedleIcon" TargetType="shapes:Path">
    <Setter Property="Data" Value="M13 23 L16.6 12 L13 14 L9.4 12 Z" />
  </Style>
</ResourceDictionary>
