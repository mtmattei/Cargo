<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============================================================
       Motion tokens. Every curve and duration in the app resolves here;
       code reads the same keys through Domain/Motion.cs.
       ============================================================ -->

  <!-- ── Curves ───────────────────────────────────────────────── -->
  <KeySpline x:Key="EaseSmooth" ControlPoint1="0.22,1" ControlPoint2="0.36,1" />
  <KeySpline x:Key="EaseOut" ControlPoint1="0.17,1" ControlPoint2="0.32,1" />
  <KeySpline x:Key="EaseInOut" ControlPoint1="0.66,0" ControlPoint2="0.34,1" />

  <!-- ── Durations (ms, for Composition) ──────────────────────── -->
  <x:Double x:Key="DurationPressMs">120</x:Double>
  <x:Double x:Key="DurationFastMs">150</x:Double>
  <x:Double x:Key="DurationStateMs">180</x:Double>
  <x:Double x:Key="DurationSlideMs">200</x:Double>
  <x:Double x:Key="DurationRollMs">280</x:Double>
  <x:Double x:Key="DurationBarMs">300</x:Double>
  <x:Double x:Key="DurationResolveMs">400</x:Double>

  <!-- ── Durations (Storyboard) ───────────────────────────────── -->
  <Duration x:Key="DurationPress">0:0:0.12</Duration>
  <Duration x:Key="DurationFast">0:0:0.15</Duration>
  <Duration x:Key="DurationState">0:0:0.18</Duration>
  <Duration x:Key="DurationSlide">0:0:0.2</Duration>
  <Duration x:Key="DurationBar">0:0:0.3</Duration>
  <Duration x:Key="DurationResolve">0:0:0.4</Duration>

  <!-- ── Distances ────────────────────────────────────────────── -->
  <!-- Rolling digits travel this fraction of the font size -->
  <x:Double x:Key="RollTravelEm">0.6</x:Double>
  <x:Double x:Key="EntranceRise">6</x:Double>
  <x:Double x:Key="PressScale">0.98</x:Double>

  <!-- Row radius; control 8 and panel 12 live in Tokens.xaml -->
  <CornerRadius x:Key="RadiusRow">4</CornerRadius>

</ResourceDictionary>
