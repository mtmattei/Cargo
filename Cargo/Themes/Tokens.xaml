<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============================================================
       Westhaven Dispatch — design tokens
       Palette from "A · One timeline (v6)" (docs/design/overview-timeline/EXTRACTION.md §1);
       harbour plant and cargo classes kept from "Quay Port v4".
       Nothing in the app hardcodes a colour; everything resolves here.
       ============================================================ -->

  <!-- ── Neutrals ─────────────────────────────────────────────── -->
  <Color x:Key="InkColor">#FF121617</Color>
  <Color x:Key="InkDeepColor">#FF101314</Color>
  <Color x:Key="InkRaisedColor">#FF1F2629</Color>
  <!-- Ground: the page behind every panel -->
  <Color x:Key="PaperColor">#FFF3F3F1</Color>
  <Color x:Key="PaperWarmColor">#FFF3F2EE</Color>
  <!-- Surface: header, panels, light tags, HUD floats, popovers -->
  <Color x:Key="SurfaceColor">#FFFBFBFA</Color>
  <Color x:Key="SurfaceSunkColor">#FFF0F0ED</Color>
  <Color x:Key="SurfaceSunkAltColor">#FFE9EAE6</Color>
  <Color x:Key="LandColor">#FFE6E7E2</Color>
  <Color x:Key="RoadColor">#FFDDD7CA</Color>
  <!-- Secondary text, darkened to pass WCAG AA on Paper (muted 5.2:1, faint 4.6:1) -->
  <Color x:Key="TextMutedColor">#FF5E6569</Color>
  <Color x:Key="TextFaintColor">#FF6B7377</Color>
  <Color x:Key="TextOnDarkMutedColor">#FF9AA4A8</Color>
  <Color x:Key="TextOnDarkColor">#FFC9CED1</Color>

  <!-- ── Brand / harbour ──────────────────────────────────────── -->
  <!-- Accent: active tab, primary button, focus ring, links, reserved berth, approach route, MOVES lane -->
  <Color x:Key="AccentColor">#FF1C6E9E</Color>
  <Color x:Key="AccentDarkColor">#FF155A82</Color>
  <!-- Text and marks on accent and alert-ink grounds (avatar initials, primary button, count badge) -->
  <Color x:Key="OnAccentColor">#FFFFFFFF</Color>
  <!-- Accent on dark grounds (scanner, dark tag): the water blue holds 5.9:1 on ink -->
  <Color x:Key="AccentBrightColor">#FF5598C4</Color>
  <!-- Pale accent for active text on the dark scanner stage (water blue lifted toward white) -->
  <Color x:Key="AccentPaleColor">#FFA7C8DE</Color>
  <!-- Navy: vessel / happened (filled markers, hulls, cargo in) -->
  <Color x:Key="NavyColor">#FF0F4A6E</Color>
  <!-- Water: tide, cargo out, waterline and wake -->
  <Color x:Key="WaterColor">#FF5598C4</Color>
  <Color x:Key="SeaGreenColor">#FF1E8F7A</Color>
  <Color x:Key="ShallowsColor">#FFCBDCE5</Color>
  <Color x:Key="QuayColor">#FF5F6B76</Color>
  <Color x:Key="QuayEdgeColor">#FF2C3944</Color>

  <!-- ── Status ───────────────────────────────────────────────── -->
  <Color x:Key="AmberColor">#FFE0A72F</Color>
  <Color x:Key="AmberDeepColor">#FFC9A227</Color>
  <Color x:Key="OrangeColor">#FFD9822B</Color>
  <!-- Ink variants: status colours set as text (≥ 5:1 on Paper). The bright tones stay for fills and marks. -->
  <Color x:Key="OrangeInkColor">#FF9A5212</Color>
  <Color x:Key="AmberInkColor">#FF8A6307</Color>
  <Color x:Key="SeaGreenInkColor">#FF146B5B</Color>
  <!-- Alert: needs-you marks and icons; AlertInk for needs-you text, late text and the count badge -->
  <Color x:Key="AlertColor">#FFC9553B</Color>
  <Color x:Key="AlertInkColor">#FFB04A32</Color>
  <Color x:Key="RestrictedColor">#FFB04A3C</Color>

  <!-- ── Cargo classes ────────────────────────────────────────── -->
  <Color x:Key="CargoStandardColor">#FF4F79A0</Color>
  <Color x:Key="CargoReeferColor">#FF8CB4CA</Color>
  <Color x:Key="CargoHazardColor">#FFC65C45</Color>
  <Color x:Key="CargoOversizeColor">#FFC9A311</Color>
  <Color x:Key="CargoEmptyColor">#FFD8D4CA</Color>

  <!-- ── Ship glyphs (Next 6 h, to scale) ───────────────────────── -->
  <!-- Container greys for the glyphs' deck stacks; accent and water join them (EXTRACTION §1) -->
  <Color x:Key="GlyphBoxPaleColor">#FFD3D8DA</Color>
  <Color x:Key="GlyphBoxLightColor">#FFC4CBCE</Color>
  <Color x:Key="GlyphBoxSlateColor">#FF8A9399</Color>
  <Color x:Key="GlyphBoxMistColor">#FFB9C0C4</Color>
  <Color x:Key="GlyphBoxStoneColor">#FFA3AFB6</Color>
  <Color x:Key="GlyphBridgeColor">#FFE7EAEB</Color>

  <!-- ── Hulls & harbour plant ────────────────────────────────── -->
  <Color x:Key="HullColor">#FF243442</Color>
  <Color x:Key="BootToppingColor">#FFA94E3F</Color>
  <Color x:Key="DeckWhiteColor">#FFF5F4EF</Color>
  <Color x:Key="BridgeColor">#FF31495B</Color>
  <Color x:Key="SteelColor">#FF1F2629</Color>
  <Color x:Key="SeaLightColor">#FFD6E3EC</Color>
  <Color x:Key="SeaMidColor">#FFB9CDDB</Color>
  <Color x:Key="SeaFlatColor">#FFBFD3E0</Color>
  <Color x:Key="RiverBankColor">#FFDCDED8</Color>
  <Color x:Key="RiverEdgeColor">#FFC7D6D2</Color>
  <Color x:Key="RiverLightColor">#FF8FB9B3</Color>
  <Color x:Key="RiverDeepColor">#FF4F8F8A</Color>

  <!-- Terminal apron markings -->
  <Color x:Key="ApronLineColor">#FF6B757C</Color>

  <!-- Container livery beyond the five cargo classes -->
  <Color x:Key="ContainerRustColor">#FF7A4A3A</Color>
  <Color x:Key="ContainerMagentaColor">#FFC94F9A</Color>
  <Color x:Key="ContainerOliveColor">#FF5B7C4A</Color>
  <Color x:Key="ContainerSageColor">#FF8A8F7A</Color>

  <!-- ── Harbour scene (3D stage) ─────────────────────────────── -->
  <!-- High-key "miniature" light: near-white concrete, blue-violet shadows. Saturated colour
       in the scene is status only (Amber reserved, Alert restricted); everything else is muted. -->
  <Color x:Key="HarbourStageColor">#FFEDF0F1</Color>
  <Color x:Key="HarbourLandColor">#FFE5E5E1</Color>
  <Color x:Key="HarbourApronColor">#FFDDDDD8</Color>
  <Color x:Key="HarbourPadColor">#FFDADAD4</Color>
  <Color x:Key="HarbourRoadColor">#FFCDCEC9</Color>
  <Color x:Key="HarbourMarkColor">#FFF7F7F4</Color>
  <Color x:Key="HarbourRailColor">#FF9398A0</Color>
  <Color x:Key="HarbourSafetyColor">#FFD2BC82</Color>
  <Color x:Key="HarbourQuaySideColor">#FFB3B6B7</Color>
  <Color x:Key="HarbourSeaNearColor">#FFA8CAD6</Color>
  <Color x:Key="HarbourSeaFarColor">#FFC9DDE4</Color>
  <Color x:Key="HarbourDepthInkColor">#FF1E384C</Color>
  <Color x:Key="HarbourShadowColor">#FF3A427A</Color>
  <Color x:Key="HarbourSkyTintColor">#FF96A4CC</Color>
  <Color x:Key="HarbourWakeColor">#FFFFFFFF</Color>
  <Color x:Key="HarbourGlintColor">#FFFFFAEE</Color>
  <Color x:Key="HarbourSignColor">#FF464E54</Color>
  <Color x:Key="HarbourTreeColor">#FF8FAE86</Color>
  <Color x:Key="HarbourTreeLightColor">#FFA9C49F</Color>
  <Color x:Key="HarbourSteelColor">#FF5E676D</Color>
  <Color x:Key="HarbourCapColor">#FF2F3538</Color>
  <Color x:Key="HarbourGlassColor">#FF2C3438</Color>
  <Color x:Key="HarbourHouseColor">#FFE7E9E9</Color>
  <Color x:Key="HarbourDeckColor">#FF6F777C</Color>
  <Color x:Key="HarbourBootColor">#FF8A4B42</Color>
  <Color x:Key="HarbourCraneColor">#FFA9C3D6</Color>
  <Color x:Key="HarbourCraneDarkColor">#FF7F95A6</Color>
  <Color x:Key="HarbourRtgColor">#FFD4BA6E</Color>
  <Color x:Key="HarbourTugColor">#FFB07F76</Color>
  <Color x:Key="HarbourBuoyPortColor">#FFA8584E</Color>
  <Color x:Key="HarbourBuoyStarboardColor">#FF4E7F5E</Color>
  <Color x:Key="HarbourBuildingColor">#FFDADCDC</Color>
  <Color x:Key="HarbourRoofColor">#FFC9CDCF</Color>
  <Color x:Key="HarbourShedColor">#FFC9CCCD</Color>
  <Color x:Key="HarbourShedRoofColor">#FFB8BDBF</Color>
  <Color x:Key="HarbourVentColor">#FFB9BEC1</Color>
  <!-- Container liveries, desaturated. No green (reads as status) and no signal red. -->
  <Color x:Key="LiveryBlueColor">#FF7FA6C4</Color>
  <Color x:Key="LiveryRustColor">#FF9C6B57</Color>
  <Color x:Key="LiveryOrangeColor">#FFC98A4E</Color>
  <Color x:Key="LiveryMagentaColor">#FFA0708F</Color>
  <Color x:Key="LiveryWhiteColor">#FFD8DADB</Color>
  <Color x:Key="LiveryGreyColor">#FFA4A9AC</Color>
  <Color x:Key="LiveryBeigeColor">#FFCDB67E</Color>
  <Color x:Key="LiveryNavyColor">#FF52657A</Color>
  <Color x:Key="LiveryOxideColor">#FF8E5E55</Color>
  <!-- Operator hull and funnel colours -->
  <Color x:Key="HullMscColor">#FF2F3A48</Color>
  <Color x:Key="FunnelMscColor">#FFD9C084</Color>
  <Color x:Key="HullOneColor">#FF5E4458</Color>
  <Color x:Key="FunnelOneColor">#FFA0708F</Color>
  <Color x:Key="HullMaerskColor">#FF53708A</Color>
  <Color x:Key="FunnelMaerskColor">#FFD8DADB</Color>
  <Color x:Key="HullHapagColor">#FF3B4A5C</Color>
  <Color x:Key="FunnelHapagColor">#FFC98A4E</Color>
  <Color x:Key="HullCmaColor">#FF34455E</Color>
  <Color x:Key="FunnelCmaColor">#FF8FB3CF</Color>

  <!-- ── X-ray / scanner ──────────────────────────────────────── -->
  <!-- The scanner stage: a dark radial well behind the 3D box -->
  <Color x:Key="ScanStageInnerColor">#FF132A2B</Color>
  <Color x:Key="ScanStageOuterColor">#FF0B1112</Color>
  <Color x:Key="ScanOrganicColor">#FFFF9A3C</Color>
  <Color x:Key="ScanMetallicColor">#FF4FB3A9</Color>
  <Color x:Key="ScanMixedColor">#FF7BD6B5</Color>
  <Color x:Key="ScanAnomalyColor">#FFFF4D4D</Color>

  <!-- ── Brushes ──────────────────────────────────────────────── -->
  <!-- The app is light-only on purpose (App.xaml RequestedTheme="Light"; the design defines one palette),
       so every brush has one value and says so in its name: *InvariantBrush. A dark theme would move
       these into ThemeDictionaries and drop the suffix. -->
  <SolidColorBrush x:Key="InkInvariantBrush" Color="{StaticResource InkColor}" />
  <SolidColorBrush x:Key="InkDeepInvariantBrush" Color="{StaticResource InkDeepColor}" />
  <SolidColorBrush x:Key="PaperInvariantBrush" Color="{StaticResource PaperColor}" />
  <SolidColorBrush x:Key="PaperWarmInvariantBrush" Color="{StaticResource PaperWarmColor}" />
  <SolidColorBrush x:Key="SurfaceInvariantBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceSunkInvariantBrush" Color="{StaticResource SurfaceSunkColor}" />
  <SolidColorBrush x:Key="SurfaceSunkAltInvariantBrush" Color="{StaticResource SurfaceSunkAltColor}" />
  <SolidColorBrush x:Key="LandInvariantBrush" Color="{StaticResource LandColor}" />
  <SolidColorBrush x:Key="RoadInvariantBrush" Color="{StaticResource RoadColor}" />
  <SolidColorBrush x:Key="TextMutedInvariantBrush" Color="{StaticResource TextMutedColor}" />
  <SolidColorBrush x:Key="TextFaintInvariantBrush" Color="{StaticResource TextFaintColor}" />
  <SolidColorBrush x:Key="TextOnDarkMutedBrush" Color="{StaticResource TextOnDarkMutedColor}" />
  <SolidColorBrush x:Key="TextOnDarkBrush" Color="{StaticResource TextOnDarkColor}" />

  <SolidColorBrush x:Key="AccentInvariantBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentDarkInvariantBrush" Color="{StaticResource AccentDarkColor}" />
  <SolidColorBrush x:Key="OnAccentInvariantBrush" Color="{StaticResource OnAccentColor}" />
  <SolidColorBrush x:Key="AccentBrightInvariantBrush" Color="{StaticResource AccentBrightColor}" />
  <SolidColorBrush x:Key="AccentPaleInvariantBrush" Color="{StaticResource AccentPaleColor}" />
  <SolidColorBrush x:Key="NavyInvariantBrush" Color="{StaticResource NavyColor}" />
  <SolidColorBrush x:Key="WaterInvariantBrush" Color="{StaticResource WaterColor}" />
  <SolidColorBrush x:Key="SeaGreenInvariantBrush" Color="{StaticResource SeaGreenColor}" />
  <SolidColorBrush x:Key="ShallowsInvariantBrush" Color="{StaticResource ShallowsColor}" />
  <SolidColorBrush x:Key="QuayInvariantBrush" Color="{StaticResource QuayColor}" />
  <SolidColorBrush x:Key="QuayEdgeInvariantBrush" Color="{StaticResource QuayEdgeColor}" />

  <SolidColorBrush x:Key="AmberInvariantBrush" Color="{StaticResource AmberColor}" />
  <SolidColorBrush x:Key="AmberDeepInvariantBrush" Color="{StaticResource AmberDeepColor}" />
  <SolidColorBrush x:Key="HarbourStageInvariantBrush" Color="{StaticResource HarbourStageColor}" />
  <SolidColorBrush x:Key="OrangeInvariantBrush" Color="{StaticResource OrangeColor}" />
  <SolidColorBrush x:Key="OrangeInkInvariantBrush" Color="{StaticResource OrangeInkColor}" />
  <SolidColorBrush x:Key="AmberInkInvariantBrush" Color="{StaticResource AmberInkColor}" />
  <SolidColorBrush x:Key="SeaGreenInkInvariantBrush" Color="{StaticResource SeaGreenInkColor}" />
  <SolidColorBrush x:Key="AlertInvariantBrush" Color="{StaticResource AlertColor}" />
  <SolidColorBrush x:Key="AlertInkInvariantBrush" Color="{StaticResource AlertInkColor}" />
  <SolidColorBrush x:Key="RestrictedInvariantBrush" Color="{StaticResource RestrictedColor}" />

  <SolidColorBrush x:Key="CargoStandardInvariantBrush" Color="{StaticResource CargoStandardColor}" />
  <SolidColorBrush x:Key="CargoReeferInvariantBrush" Color="{StaticResource CargoReeferColor}" />
  <SolidColorBrush x:Key="CargoHazardInvariantBrush" Color="{StaticResource CargoHazardColor}" />
  <SolidColorBrush x:Key="CargoOversizeInvariantBrush" Color="{StaticResource CargoOversizeColor}" />
  <SolidColorBrush x:Key="HullInvariantBrush" Color="{StaticResource HullColor}" />
  <SolidColorBrush x:Key="BootToppingInvariantBrush" Color="{StaticResource BootToppingColor}" />
  <SolidColorBrush x:Key="DeckWhiteInvariantBrush" Color="{StaticResource DeckWhiteColor}" />
  <SolidColorBrush x:Key="BridgeInvariantBrush" Color="{StaticResource BridgeColor}" />
  <SolidColorBrush x:Key="SteelInvariantBrush" Color="{StaticResource SteelColor}" />
  <SolidColorBrush x:Key="SeaFlatInvariantBrush" Color="{StaticResource SeaFlatColor}" />
  <SolidColorBrush x:Key="RiverBankInvariantBrush" Color="{StaticResource RiverBankColor}" />
  <!-- Water-level charts share the river map's water: the deep water as the line, a fade below it -->
  <SolidColorBrush x:Key="WaterLineInvariantBrush" Color="{StaticResource RiverDeepColor}" />
  <Color x:Key="RiverDeepClearColor">#004F8F8A</Color>
  <LinearGradientBrush x:Key="WaterFadeInvariantBrush" StartPoint="0,0" EndPoint="0,1" Opacity="0.34">
    <GradientStop Offset="0" Color="{StaticResource RiverDeepColor}" />
    <GradientStop Offset="1" Color="{StaticResource RiverDeepClearColor}" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="RiverEdgeInvariantBrush" Color="{StaticResource RiverEdgeColor}" />

  <!-- Hairlines: the design leans on 8–18% ink rules rather than boxes -->
  <SolidColorBrush x:Key="HairlineInvariantBrush" Color="{StaticResource InkColor}" Opacity="0.08" />
  <SolidColorBrush x:Key="HairlineStrongInvariantBrush" Color="{StaticResource InkColor}" Opacity="0.18" />
  <!-- A berth reserved for an arrival: the map polygon and its Key swatch -->
  <SolidColorBrush x:Key="ReservedFillInvariantBrush" Color="{StaticResource AccentColor}" Opacity="0.12" />
  <!-- The tide lane's area: water at 30% fading to 4% -->
  <SolidColorBrush x:Key="TideFillTopInvariantBrush" Color="{StaticResource WaterColor}" Opacity="0.3" />
  <SolidColorBrush x:Key="TideFillBottomInvariantBrush" Color="{StaticResource WaterColor}" Opacity="0.04" />
  <!-- Ahead of now: the timeline's future shade and its legend swatch -->
  <SolidColorBrush x:Key="AheadShadeInvariantBrush" Color="{StaticResource InkColor}" Opacity="0.03" />
  <!-- The NEEDS ACTION chip's ground: alert at 12% -->
  <SolidColorBrush x:Key="AlertChipInvariantBrush" Color="{StaticResource AlertColor}" Opacity="0.12" />
  <!-- The header tab's hover underline -->
  <SolidColorBrush x:Key="TabHoverInvariantBrush" Color="{StaticResource InkColor}" Opacity="0.16" />
  <SolidColorBrush x:Key="HairlineOnDarkBrush" Color="#FFFFFFFF" Opacity="0.10" />
  <!-- Dims the page behind a floating panel (the container scanner) without hiding where you were -->
  <SolidColorBrush x:Key="PageDimInvariantBrush" Color="{StaticResource InkDeepColor}" Opacity="0.55" />

  <!-- ── Type ─────────────────────────────────────────────────── -->
  <FontFamily x:Key="DisplayFont">ms-appx:///Assets/Fonts/BricolageGrotesque_SemiBold.ttf#Bricolage Grotesque SemiBold</FontFamily>
  <FontFamily x:Key="BodyFont">ms-appx:///Assets/Fonts/Archivo_Regular.ttf#Archivo</FontFamily>
  <FontFamily x:Key="BodyMediumFont">ms-appx:///Assets/Fonts/Archivo_Medium.ttf#Archivo Medium</FontFamily>
  <FontFamily x:Key="BodyStrongFont">ms-appx:///Assets/Fonts/Archivo_SemiBold.ttf#Archivo SemiBold</FontFamily>
  <FontFamily x:Key="MonoFont">ms-appx:///Assets/Fonts/IBMPlexMono_Regular.ttf#IBM Plex Mono</FontFamily>
  <FontFamily x:Key="MonoMediumFont">ms-appx:///Assets/Fonts/IBMPlexMono_Medium.ttf#IBM Plex Mono Medium</FontFamily>

  <!-- ── Radius ─────────────────────────────────────── -->
  <!-- Three radii. Inner radius = outer radius − padding (concentric). -->
  <CornerRadius x:Key="RadiusControl">8</CornerRadius>
  <CornerRadius x:Key="RadiusPanel">12</CornerRadius>
  <CornerRadius x:Key="RadiusCard">18</CornerRadius>
  <!-- Every section page shares one frame -->
  <Thickness x:Key="PagePadding">40,28,40,48</Thickness>

</ResourceDictionary>
