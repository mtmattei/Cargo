<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============================================================
       Westhaven Dispatch — design tokens
       Palette, type ramp and spacing lifted from "Quay Port v4".
       Nothing in the app hardcodes a colour; everything resolves here.
       ============================================================ -->

  <!-- ── Neutrals ─────────────────────────────────────────────── -->
  <Color x:Key="InkColor">#FF121617</Color>
  <Color x:Key="InkDeepColor">#FF101314</Color>
  <Color x:Key="InkRaisedColor">#FF1F2629</Color>
  <Color x:Key="PaperColor">#FFF5F5F3</Color>
  <Color x:Key="PaperWarmColor">#FFF3F2EE</Color>
  <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
  <Color x:Key="SurfaceSunkColor">#FFF0F0ED</Color>
  <Color x:Key="SurfaceSunkAltColor">#FFE9EAE6</Color>
  <Color x:Key="LandColor">#FFE6E7E2</Color>
  <Color x:Key="RoadColor">#FFDDD7CA</Color>
  <Color x:Key="TextMutedColor">#FF6F777B</Color>
  <Color x:Key="TextFaintColor">#FF8A9094</Color>
  <Color x:Key="TextOnDarkMutedColor">#FF9AA4A8</Color>
  <Color x:Key="TextOnDarkColor">#FFC9CED1</Color>

  <!-- ── Brand / harbour ──────────────────────────────────────── -->
  <Color x:Key="TealColor">#FF1E6F6A</Color>
  <Color x:Key="TealBrightColor">#FF4FB3A9</Color>
  <Color x:Key="TealDeepColor">#FF17575A</Color>
  <Color x:Key="TealPaleColor">#FF8FD3CB</Color>
  <Color x:Key="SeaGreenColor">#FF1E8F7A</Color>
  <Color x:Key="WaterColor">#FF1A5F60</Color>
  <Color x:Key="ShallowsColor">#FFCBDCE5</Color>
  <Color x:Key="QuayColor">#FF5F6B76</Color>
  <Color x:Key="QuayEdgeColor">#FF2C3944</Color>

  <!-- ── Status ───────────────────────────────────────────────── -->
  <Color x:Key="AmberColor">#FFE0A72F</Color>
  <Color x:Key="AmberDeepColor">#FFC9A227</Color>
  <Color x:Key="OrangeColor">#FFD9822B</Color>
  <Color x:Key="OrangeInkColor">#FFB8661A</Color>
  <Color x:Key="AlertColor">#FFC74B4B</Color>
  <Color x:Key="RestrictedColor">#FFB04A3C</Color>

  <!-- ── Cargo classes ────────────────────────────────────────── -->
  <Color x:Key="CargoStandardColor">#FF4F79A0</Color>
  <Color x:Key="CargoReeferColor">#FF8CB4CA</Color>
  <Color x:Key="CargoHazardColor">#FFC65C45</Color>
  <Color x:Key="CargoOversizeColor">#FFC9A311</Color>
  <Color x:Key="CargoEmptyColor">#FFD8D4CA</Color>

  <!-- ── Hulls & harbour plant ────────────────────────────────── -->
  <Color x:Key="HullColor">#FF243442</Color>
  <Color x:Key="HullShadowColor">#FF1E2A35</Color>
  <Color x:Key="BootToppingColor">#FFA94E3F</Color>
  <Color x:Key="HullTrimColor">#FF8696A2</Color>
  <Color x:Key="DeckWhiteColor">#FFF5F4EF</Color>
  <Color x:Key="BridgeColor">#FF31495B</Color>
  <Color x:Key="WindowFrameColor">#FFCBD0D3</Color>
  <Color x:Key="PortholeColor">#FF111922</Color>
  <Color x:Key="VentColor">#FF9FB2BF</Color>
  <Color x:Key="SteelColor">#FF1F2629</Color>
  <Color x:Key="SeaLightColor">#FFD6E3EC</Color>
  <Color x:Key="SeaMidColor">#FFB9CDDB</Color>
  <Color x:Key="SeaFlatColor">#FFBFD3E0</Color>
  <Color x:Key="RiverBankColor">#FFDCDED8</Color>
  <Color x:Key="RiverEdgeColor">#FFC7D6D2</Color>
  <Color x:Key="RiverLightColor">#FF8FB9B3</Color>
  <Color x:Key="RiverDeepColor">#FF4F8F8A</Color>

  <!-- Terminal apron, seen from above -->
  <Color x:Key="ApronColor">#FF2E3438</Color>
  <Color x:Key="ApronLightColor">#FF3B4247</Color>
  <Color x:Key="ApronLineColor">#FF6B757C</Color>

  <!-- Container livery beyond the five cargo classes -->
  <Color x:Key="ContainerRustColor">#FF7A4A3A</Color>
  <Color x:Key="ContainerMagentaColor">#FFC94F9A</Color>
  <Color x:Key="ContainerOliveColor">#FF5B7C4A</Color>
  <Color x:Key="ContainerSageColor">#FF8A8F7A</Color>

  <!-- ── X-ray / scanner ──────────────────────────────────────── -->
  <Color x:Key="ScanOrganicColor">#FFFF9A3C</Color>
  <Color x:Key="ScanMetallicColor">#FF4FB3A9</Color>
  <Color x:Key="ScanMixedColor">#FF7BD6B5</Color>
  <Color x:Key="ScanAnomalyColor">#FFFF4D4D</Color>
  <Color x:Key="OnDarkPositiveColor">#FF8FD6B4</Color>
  <Color x:Key="OnDarkWarnColor">#FFFFD27A</Color>

  <!-- ── Brushes ──────────────────────────────────────────────── -->
  <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
  <SolidColorBrush x:Key="InkDeepBrush" Color="{StaticResource InkDeepColor}" />
  <SolidColorBrush x:Key="InkRaisedBrush" Color="{StaticResource InkRaisedColor}" />
  <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource PaperColor}" />
  <SolidColorBrush x:Key="PaperWarmBrush" Color="{StaticResource PaperWarmColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceSunkBrush" Color="{StaticResource SurfaceSunkColor}" />
  <SolidColorBrush x:Key="SurfaceSunkAltBrush" Color="{StaticResource SurfaceSunkAltColor}" />
  <SolidColorBrush x:Key="LandBrush" Color="{StaticResource LandColor}" />
  <SolidColorBrush x:Key="RoadBrush" Color="{StaticResource RoadColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
  <SolidColorBrush x:Key="TextFaintBrush" Color="{StaticResource TextFaintColor}" />
  <SolidColorBrush x:Key="TextOnDarkMutedBrush" Color="{StaticResource TextOnDarkMutedColor}" />
  <SolidColorBrush x:Key="TextOnDarkBrush" Color="{StaticResource TextOnDarkColor}" />

  <SolidColorBrush x:Key="TealBrush" Color="{StaticResource TealColor}" />
  <SolidColorBrush x:Key="TealBrightBrush" Color="{StaticResource TealBrightColor}" />
  <SolidColorBrush x:Key="TealDeepBrush" Color="{StaticResource TealDeepColor}" />
  <SolidColorBrush x:Key="TealPaleBrush" Color="{StaticResource TealPaleColor}" />
  <SolidColorBrush x:Key="SeaGreenBrush" Color="{StaticResource SeaGreenColor}" />
  <SolidColorBrush x:Key="WaterBrush" Color="{StaticResource WaterColor}" />
  <SolidColorBrush x:Key="ShallowsBrush" Color="{StaticResource ShallowsColor}" />
  <SolidColorBrush x:Key="QuayBrush" Color="{StaticResource QuayColor}" />
  <SolidColorBrush x:Key="QuayEdgeBrush" Color="{StaticResource QuayEdgeColor}" />

  <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}" />
  <SolidColorBrush x:Key="AmberDeepBrush" Color="{StaticResource AmberDeepColor}" />
  <SolidColorBrush x:Key="OrangeBrush" Color="{StaticResource OrangeColor}" />
  <SolidColorBrush x:Key="OrangeInkBrush" Color="{StaticResource OrangeInkColor}" />
  <SolidColorBrush x:Key="AlertBrush" Color="{StaticResource AlertColor}" />
  <SolidColorBrush x:Key="RestrictedBrush" Color="{StaticResource RestrictedColor}" />

  <SolidColorBrush x:Key="CargoStandardBrush" Color="{StaticResource CargoStandardColor}" />
  <SolidColorBrush x:Key="CargoReeferBrush" Color="{StaticResource CargoReeferColor}" />
  <SolidColorBrush x:Key="CargoHazardBrush" Color="{StaticResource CargoHazardColor}" />
  <SolidColorBrush x:Key="CargoOversizeBrush" Color="{StaticResource CargoOversizeColor}" />
  <SolidColorBrush x:Key="CargoEmptyBrush" Color="{StaticResource CargoEmptyColor}" />
  <SolidColorBrush x:Key="ApronBrush" Color="{StaticResource ApronColor}" />
  <SolidColorBrush x:Key="ApronLightBrush" Color="{StaticResource ApronLightColor}" />
  <SolidColorBrush x:Key="ApronLineBrush" Color="{StaticResource ApronLineColor}" />
  <SolidColorBrush x:Key="HullBrush" Color="{StaticResource HullColor}" />
  <SolidColorBrush x:Key="HullShadowBrush" Color="{StaticResource HullShadowColor}" />
  <SolidColorBrush x:Key="BootToppingBrush" Color="{StaticResource BootToppingColor}" />
  <SolidColorBrush x:Key="HullTrimBrush" Color="{StaticResource HullTrimColor}" />
  <SolidColorBrush x:Key="DeckWhiteBrush" Color="{StaticResource DeckWhiteColor}" />
  <SolidColorBrush x:Key="BridgeBrush" Color="{StaticResource BridgeColor}" />
  <SolidColorBrush x:Key="WindowFrameBrush" Color="{StaticResource WindowFrameColor}" />
  <SolidColorBrush x:Key="PortholeBrush" Color="{StaticResource PortholeColor}" />
  <SolidColorBrush x:Key="VentBrush" Color="{StaticResource VentColor}" />
  <SolidColorBrush x:Key="SteelBrush" Color="{StaticResource SteelColor}" />
  <SolidColorBrush x:Key="SeaFlatBrush" Color="{StaticResource SeaFlatColor}" />
  <SolidColorBrush x:Key="RiverBankBrush" Color="{StaticResource RiverBankColor}" />
  <SolidColorBrush x:Key="RiverEdgeBrush" Color="{StaticResource RiverEdgeColor}" />
  <SolidColorBrush x:Key="ContainerRustBrush" Color="{StaticResource ContainerRustColor}" />
  <SolidColorBrush x:Key="ContainerMagentaBrush" Color="{StaticResource ContainerMagentaColor}" />
  <SolidColorBrush x:Key="ContainerOliveBrush" Color="{StaticResource ContainerOliveColor}" />
  <SolidColorBrush x:Key="ContainerSageBrush" Color="{StaticResource ContainerSageColor}" />
  <SolidColorBrush x:Key="ScanOrganicBrush" Color="{StaticResource ScanOrganicColor}" />
  <SolidColorBrush x:Key="ScanMetallicBrush" Color="{StaticResource ScanMetallicColor}" />
  <SolidColorBrush x:Key="ScanMixedBrush" Color="{StaticResource ScanMixedColor}" />
  <SolidColorBrush x:Key="ScanAnomalyBrush" Color="{StaticResource ScanAnomalyColor}" />
  <SolidColorBrush x:Key="OnDarkPositiveBrush" Color="{StaticResource OnDarkPositiveColor}" />
  <SolidColorBrush x:Key="OnDarkWarnBrush" Color="{StaticResource OnDarkWarnColor}" />

  <!-- Hairlines: the design leans on 8–14% ink rules rather than boxes -->
  <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource InkColor}" Opacity="0.08" />
  <SolidColorBrush x:Key="HairlineStrongBrush" Color="{StaticResource InkColor}" Opacity="0.14" />
  <SolidColorBrush x:Key="HairlineFaintBrush" Color="{StaticResource InkColor}" Opacity="0.045" />
  <SolidColorBrush x:Key="HairlineOnDarkBrush" Color="#FFFFFFFF" Opacity="0.10" />
  <SolidColorBrush x:Key="ScrimBrush" Color="{StaticResource InkDeepColor}" Opacity="0.86" />

  <!-- ── Type ─────────────────────────────────────────────────── -->
  <FontFamily x:Key="DisplayFont">ms-appx:///Assets/Fonts/BricolageGrotesque-SemiBold.ttf#Bricolage Grotesque SemiBold</FontFamily>
  <FontFamily x:Key="DisplayBoldFont">ms-appx:///Assets/Fonts/BricolageGrotesque-Bold.ttf#Bricolage Grotesque</FontFamily>
  <FontFamily x:Key="BodyFont">ms-appx:///Assets/Fonts/Archivo-Regular.ttf#Archivo</FontFamily>
  <FontFamily x:Key="BodyMediumFont">ms-appx:///Assets/Fonts/Archivo-Medium.ttf#Archivo Medium</FontFamily>
  <FontFamily x:Key="BodyStrongFont">ms-appx:///Assets/Fonts/Archivo-SemiBold.ttf#Archivo SemiBold</FontFamily>
  <FontFamily x:Key="MonoFont">ms-appx:///Assets/Fonts/IBMPlexMono-Regular.ttf#IBM Plex Mono</FontFamily>
  <FontFamily x:Key="MonoMediumFont">ms-appx:///Assets/Fonts/IBMPlexMono-Medium.ttf#IBM Plex Mono Medium</FontFamily>

</ResourceDictionary>
