<UserControl x:Class="Cargo.Controls.Harbour.HarbourView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:harbour="using:Cargo.Controls.Harbour"
             xmlns:controls="using:Cargo.Controls"
             xmlns:utu="using:Uno.Toolkit.UI"
             xmlns:presentation="using:Cargo.Presentation"
             xmlns:shapes="using:Microsoft.UI.Xaml.Shapes"
             IsTabStop="True"
             UseSystemFocusVisuals="True"
             AutomationProperties.Name="Harbour map. Arrow keys orbit, plus and minus zoom, zero resets.">

  <UserControl.Resources>
    <!-- A vessel's data tag: the name and one status line, expanding to the key facts when selected -->
    <!-- The facts card opens above the chip, so it never covers the vessel it describes -->
    <DataTemplate x:Key="HarbourTagTemplate" x:DataType="harbour:HarbourTag">
      <StackPanel Spacing="4">
        <utu:CardContentControl Style="{StaticResource PanelCard}" Visibility="{x:Bind Expanded, Mode=OneWay}" CornerRadius="8" Padding="12,10" MinWidth="220">
          <StackPanel Spacing="10">
            <ItemsControl ItemsSource="{x:Bind Facts}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <controls:TwoColumnPanel ColumnSpacing="16" RowSpacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="presentation:Fact">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{x:Bind Key}" Style="{StaticResource CaptionText}" />
                    <TextBlock Text="{x:Bind Value}" Style="{StaticResource BodyStrongSmallText}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Style="{StaticResource GhostButton}" Command="{x:Bind Open}" CommandParameter="{x:Bind Id}"
                    Content="Open vessel profile →" HorizontalAlignment="Stretch" />
          </StackPanel>
        </utu:CardContentControl>

        <Button Style="{StaticResource BareButton}" Command="{x:Bind Toggle}" CommandParameter="{x:Bind Id}"
                controls:HoverLink.Command="{x:Bind Hover}" controls:HoverLink.Key="{x:Bind Id}"
                AutomationProperties.Name="{x:Bind AccessibleName}" HorizontalAlignment="Center">
          <Grid>
            <!-- Light tag: name and status on one 30 px line, on the float shadow.
                 Shadows inline: a Style-supplied collection never applies (Toolkit gotcha G36). -->
            <utu:ShadowContainer Background="{StaticResource SurfaceInvariantBrush}" Visibility="{x:Bind LightVisibility, Mode=OneWay}">
              <utu:ShadowContainer.Shadows>
                <utu:ShadowCollection>
                  <utu:Shadow Spread="1" BlurRadius="0" Color="{StaticResource InkColor}" Opacity="0.08" />
                  <utu:Shadow OffsetY="1" BlurRadius="2" Color="{StaticResource InkColor}" Opacity="0.06" />
                  <utu:Shadow OffsetY="6" BlurRadius="20" Color="{StaticResource InkColor}" Opacity="0.07" />
                </utu:ShadowCollection>
              </utu:ShadowContainer.Shadows>
              <!-- xaml-lint: allow card - a data-tag chip on a leader line, not a content card -->
              <Border CornerRadius="8" Height="30" Padding="10,0"
                      BorderBrush="{x:Bind Edge, Mode=OneWay}" BorderThickness="{x:Bind EdgeThickness, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="{x:Bind Name}" Style="{StaticResource TypeStrong13}" Foreground="{StaticResource InkInvariantBrush}" />
                  <TextBlock Text="{x:Bind Sub}" Style="{StaticResource TypeMono12}" Foreground="{StaticResource TextMutedInvariantBrush}" />
                </StackPanel>
              </Border>
            </utu:ShadowContainer>

            <!-- Dark tag: the arrival waiting on its berth, with the time to go -->
            <utu:ShadowContainer Background="{StaticResource InkInvariantBrush}" Visibility="{x:Bind DarkVisibility, Mode=OneWay}">
              <utu:ShadowContainer.Shadows>
                <utu:ShadowCollection>
                  <utu:Shadow OffsetY="6" BlurRadius="20" Color="{StaticResource InkColor}" Opacity="0.18" />
                </utu:ShadowCollection>
              </utu:ShadowContainer.Shadows>
              <!-- xaml-lint: allow card - a data-tag chip on a leader line, not a content card -->
              <Border CornerRadius="8" Padding="12,8"
                      BorderBrush="{x:Bind Edge, Mode=OneWay}" BorderThickness="{x:Bind EdgeThickness, Mode=OneWay}">
                <StackPanel Spacing="3">
                  <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource TypeStrong13}" Foreground="{StaticResource SurfaceInvariantBrush}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Countdown, Mode=OneWay}" Style="{StaticResource TypeMonoMedium12}"
                               Foreground="{StaticResource SurfaceInvariantBrush}" />
                  </Grid>
                  <TextBlock Text="{x:Bind PendingSub}" Style="{StaticResource TypeMono12}" Foreground="{StaticResource TextOnDarkBrush}" />
                </StackPanel>
              </Border>
            </utu:ShadowContainer>
          </Grid>
        </Button>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Background="{StaticResource HarbourStageInvariantBrush}">
    <Border x:Name="SceneHost" Background="Transparent" />

    <Canvas x:Name="TagLayer" />

    <!-- Screen-reader summary (HarbourView.UpdateSummary): present to automation, invisible on screen -->
    <TextBlock x:Name="Summary" Opacity="0" IsHitTestVisible="False" Width="1" Height="1"
               HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.LiveSetting="Polite" />

    <!-- HUD floats: surface on the float shadow. The shadow collection is repeated on each
         container because a Style-supplied one never applies (Toolkit gotcha G36). -->

    <!-- Camera: the current preset, opening the four presets upward; a drag or zoom clears the check -->
    <utu:ShadowContainer Background="{StaticResource SurfaceInvariantBrush}" Visibility="{x:Bind HudVisibility, Mode=OneWay}"
                         HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="40,0,0,16">
      <utu:ShadowContainer.Shadows>
        <utu:ShadowCollection>
          <utu:Shadow Spread="1" BlurRadius="0" Color="{StaticResource InkColor}" Opacity="0.08" />
          <utu:Shadow OffsetY="1" BlurRadius="2" Color="{StaticResource InkColor}" Opacity="0.06" />
          <utu:Shadow OffsetY="6" BlurRadius="20" Color="{StaticResource InkColor}" Opacity="0.07" />
        </utu:ShadowCollection>
      </utu:ShadowContainer.Shadows>
      <Button Style="{StaticResource HudSummaryButton}" AutomationProperties.Name="Camera view">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock x:Name="CameraLabel" Text="Overview" Style="{StaticResource TypeMedium14}" VerticalAlignment="Center" />
          <Viewbox Width="16" Height="16" VerticalAlignment="Center">
            <Grid Width="24" Height="24">
              <shapes:Path Style="{StaticResource ChevronDownIcon}" Stroke="{StaticResource InkInvariantBrush}" />
            </Grid>
          </Viewbox>
        </StackPanel>
        <Button.Flyout>
          <MenuFlyout Placement="Top">
            <RadioMenuFlyoutItem x:Name="OverviewItem" Text="Overview" GroupName="Camera" IsChecked="True" Command="{x:Bind ViewCommand}" CommandParameter="overview" />
            <RadioMenuFlyoutItem x:Name="SeaItem" Text="From sea" GroupName="Camera" Command="{x:Bind ViewCommand}" CommandParameter="sea" />
            <RadioMenuFlyoutItem x:Name="LandItem" Text="From land" GroupName="Camera" Command="{x:Bind ViewCommand}" CommandParameter="land" />
            <RadioMenuFlyoutItem x:Name="PlanItem" Text="Plan" GroupName="Camera" Command="{x:Bind ViewCommand}" CommandParameter="plan" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
    </utu:ShadowContainer>

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,16"
                Visibility="{x:Bind HudVisibility, Mode=OneWay}">
      <!-- Key: what each mark on the map means -->
      <utu:ShadowContainer Background="{StaticResource SurfaceInvariantBrush}">
        <utu:ShadowContainer.Shadows>
          <utu:ShadowCollection>
            <utu:Shadow Spread="1" BlurRadius="0" Color="{StaticResource InkColor}" Opacity="0.08" />
            <utu:Shadow OffsetY="1" BlurRadius="2" Color="{StaticResource InkColor}" Opacity="0.06" />
            <utu:Shadow OffsetY="6" BlurRadius="20" Color="{StaticResource InkColor}" Opacity="0.07" />
          </utu:ShadowCollection>
        </utu:ShadowContainer.Shadows>
        <Button Style="{StaticResource HudSummaryButton}" Content="Key" AutomationProperties.Name="Map key">
          <Button.Flyout>
            <Flyout Placement="TopEdgeAlignedRight">
              <StackPanel MinWidth="208">
                <TextBlock Text="KEY" Style="{StaticResource CapsLabelText}" Margin="10,8,10,4" />
                <StackPanel Orientation="Horizontal" Spacing="10" Padding="10,8">
                  <Ellipse Width="9" Height="9" Fill="{StaticResource NavyInvariantBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="Vessel alongside" Style="{StaticResource KeyRowText}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" Padding="10,8">
                  <Ellipse Width="9" Height="9" Stroke="{StaticResource NavyInvariantBrush}" StrokeThickness="1.6" VerticalAlignment="Center" />
                  <TextBlock Text="Vessel inbound" Style="{StaticResource KeyRowText}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" Padding="10,8">
                  <Rectangle Width="14" Height="12" RadiusX="2" RadiusY="2" Fill="{StaticResource ReservedFillInvariantBrush}" Stroke="{StaticResource AccentInvariantBrush}" StrokeThickness="1.5" StrokeDashArray="2,1.5" VerticalAlignment="Center" />
                  <TextBlock Text="Berth reserved for an arrival" Style="{StaticResource KeyRowText}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" Padding="10,8">
                  <Rectangle Width="14" Height="12" RadiusX="2" RadiusY="2" Fill="{StaticResource HairlineInvariantBrush}" Stroke="{StaticResource TextMutedInvariantBrush}" StrokeThickness="1.5" StrokeDashArray="2,1.5" VerticalAlignment="Center" />
                  <TextBlock Text="Restricted" Style="{StaticResource KeyRowText}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" Padding="10,8">
                  <Line X1="0" Y1="0" X2="14" Y2="0" Width="14" Stroke="{StaticResource TextMutedInvariantBrush}" StrokeThickness="1.5" StrokeDashArray="2,1.5" VerticalAlignment="Center" />
                  <TextBlock Text="Depth contour, metres" Style="{StaticResource KeyRowText}" />
                </StackPanel>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </utu:ShadowContainer>

      <!-- Scale, north, zoom: one float, cells split by hairlines -->
      <utu:ShadowContainer Background="{StaticResource SurfaceInvariantBrush}">
        <utu:ShadowContainer.Shadows>
          <utu:ShadowCollection>
            <utu:Shadow Spread="1" BlurRadius="0" Color="{StaticResource InkColor}" Opacity="0.08" />
            <utu:Shadow OffsetY="1" BlurRadius="2" Color="{StaticResource InkColor}" Opacity="0.06" />
            <utu:Shadow OffsetY="6" BlurRadius="20" Color="{StaticResource InkColor}" Opacity="0.07" />
          </utu:ShadowCollection>
        </utu:ShadowContainer.Shadows>
        <Grid CornerRadius="10" Height="44">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="44" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="44" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="44" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="8" Padding="14,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False">
            <Border x:Name="ScaleBar" Height="6" Width="64" VerticalAlignment="Center"
                    BorderBrush="{StaticResource InkInvariantBrush}" BorderThickness="1.5,0,1.5,1.5" />
            <TextBlock x:Name="ScaleLabel" Text="250 m" Style="{StaticResource TypeMonoMedium12}"
                       Foreground="{StaticResource InkInvariantBrush}" VerticalAlignment="Center" />
          </StackPanel>
          <Rectangle Grid.Column="1" Fill="{StaticResource HairlineInvariantBrush}" />
          <Viewbox Grid.Column="2" Width="20" Height="20" IsHitTestVisible="False" AutomationProperties.Name="North">
            <Canvas Width="26" Height="26">
              <Canvas.RenderTransform>
                <RotateTransform x:Name="Needle" CenterX="13" CenterY="13" />
              </Canvas.RenderTransform>
              <shapes:Path Style="{StaticResource NorthNeedleIcon}" Fill="{StaticResource AlertInvariantBrush}" />
              <shapes:Path Style="{StaticResource SouthNeedleIcon}" Fill="{StaticResource HairlineStrongInvariantBrush}" />
            </Canvas>
          </Viewbox>
          <Rectangle Grid.Column="3" Fill="{StaticResource HairlineInvariantBrush}" />
          <Button Grid.Column="4" Style="{StaticResource HudIconButton}" Command="{x:Bind ZoomCommand}" CommandParameter="out"
                  AutomationProperties.Name="Zoom out">
            <Viewbox Width="18" Height="18">
              <Grid Width="24" Height="24">
                <shapes:Path Style="{StaticResource MinusIcon}" Stroke="{StaticResource InkInvariantBrush}" />
              </Grid>
            </Viewbox>
          </Button>
          <Rectangle Grid.Column="5" Fill="{StaticResource HairlineInvariantBrush}" />
          <Button Grid.Column="6" Style="{StaticResource HudIconButton}" Command="{x:Bind ZoomCommand}" CommandParameter="in"
                  AutomationProperties.Name="Zoom in">
            <Viewbox Width="18" Height="18">
              <Grid Width="24" Height="24">
                <shapes:Path Style="{StaticResource PlusIcon}" Stroke="{StaticResource InkInvariantBrush}" />
              </Grid>
            </Viewbox>
          </Button>
        </Grid>
      </utu:ShadowContainer>
    </StackPanel>
  </Grid>
</UserControl>
